</div>

<script>
  var P = {
    "pistachio":{n:"Фисташковый",c:"#6B8C5C",hit:1,pr:{250:1490,450:2590,1000:5490},d:"Премиальный и редкий. Ярко-фисташковый вкус.",eat:"С круассаном, в десерты, просто ложкой."},
    "hazelnut-cocoa":{n:"Фундук какао-бобы",c:"#4A2810",hit:1,pr:{250:799,450:1390,1000:2790},d:"Честная альтернатива нутелле. Только фундук и какао.",eat:"На хлеб, с блинами, в горячее молоко."},
    "cashew":{n:"Кешью",c:"#C9A96E",hit:1,pr:{250:699,450:1199,1000:2390},d:"Самый нежный. Нравится даже детям.",eat:"С фруктами, блинами, в десерты."},
    "peanut":{n:"Арахисовый",c:"#B87A3D",hit:1,pr:{250:379,450:690,1000:1390},d:"Насыщенный вкус обжаренного арахиса. Много белка.",eat:"С тостами, бананом, в кашу и смузи."},
    "almond":{n:"Миндальный",c:"#DDB97C",hit:1,pr:{250:449,450:790,1000:1590},d:"Мягкий, кремовый, самый популярный вкус.",eat:"С тостами, в кашу, в кофе."},
    "almond-cashew":{n:"Миндаль с кешью",c:"#D4B084",pr:{250:549,450:950,1000:1890},d:"Два самых нежных ореха в одной банке.",eat:"С тостами, сырниками, фруктами."},
    "three-nuts":{n:"Ассорти три ореха",c:"#A9885C",pr:{250:549,450:950,1000:1890},d:"Миндаль, кешью и арахис — богатый ореховый вкус.",eat:"На хлеб, в кашу, к сырам."},
    "hazelnut":{n:"Фундук",c:"#8A5A2B",pr:{250:749,450:1290,1000:2590},d:"Глубокий вкус лесного ореха без добавок.",eat:"С блинами, кофе, в десерты."},
    "walnut":{n:"Грецкий орех",c:"#8B7355",pr:{250:629,450:1090,1000:2190},d:"Богат омега-3. Для ума, сердца и энергии.",eat:"С мёдом, в кашу, к сырам."},
    "flax-black":{n:"Чёрный лён",c:"#33302A",pr:{250:349,450:590,1000:1190},d:"Классика здоровья: омега-3 и лёгкая горчинка.",eat:"В кашу, в смузи, с мёдом на хлеб."},
    "flax-white":{n:"Белый лён",c:"#E2D3B3",pr:{250:349,450:590,1000:1190},d:"Нежнее чёрного льна. Мягкий вкус.",eat:"В йогурт, кашу, смузи."},
    "flax-seeds":{n:"Лён с семечками",c:"#4A4136",pr:{250:379,450:650,1000:1290},d:"Лён и подсолнечные семечки — мягче и сытнее.",eat:"На завтрак с тостами, в творог."},
    "flax-mix":{n:"Ассорти со льном",c:"#7A6B4F",pr:{250:399,450:690,1000:1390},d:"Польза семян и вкус орехов в одной банке.",eat:"С хлебом, фруктами, в выпечку."},
    "sesame":{n:"Кунжут",c:"#E8DCC0",pr:{250:399,450:690,1000:1390},d:"Природный кальций и нежная тахини-текстура.",eat:"В соусы, хумус, выпечку, с мёдом."},
    "hemp":{n:"Конопля",c:"#5F7048",pr:{250:449,450:790,1000:1590},d:"Растительный белок и мягкий ореховый вкус.",eat:"В смузи, кашу, спортивное питание."},
    "thistle":{n:"Расторопша",c:"#9C9A6E",pr:{250:349,450:590,1000:1190},d:"Природная поддержка печени. Сила трав Кавказа.",eat:"По ложке утром, в смузи, с мёдом."}
  };
  var IDS = Object.keys(P);
  var money = function(v){ return new Intl.NumberFormat("ru-RU").format(v)+" ₽"; };
  var lightC = ["#E2D3B3","#E8DCC0","#DDB97C","#C9A96E","#D4B084"];
  function jar(id,big){ var p=P[id]; var w=big?120:64,h=big?164:88,fs=big?12:9;
    var col=lightC.indexOf(p.c)>=0?"#2A2118":"#F6EBDA";
    return '<div class="jar" style="background:'+p.c+';width:'+w+'px;height:'+h+'px"><span style="color:'+col+';font-size:'+fs+'px">'+p.n.toUpperCase()+'</span></div>'; }
  function card(id){ var p=P[id]; return '<article class="pcard"><div class="art" data-open="'+id+'">'+jar(id)+'</div>'+
    '<div class="b"><h3>'+p.n+'</h3><span class="w">250 г</span><span class="pr">'+money(p.pr[250])+'</span>'+
    '<button class="btn btn-green btn-sm add" data-add="'+id+'|250">В корзину</button></div></article>'; }

  document.getElementById("hits").innerHTML = IDS.filter(function(id){return P[id].hit;}).map(function(id){return '<div class="hcard">'+card(id)+'</div>';}).join("");
  document.getElementById("home-grid").innerHTML = ["pistachio","hazelnut-cocoa","almond","peanut"].map(card).join("");
  document.getElementById("cat-grid").innerHTML = IDS.map(card).join("");

  // ── КОРЗИНА (localStorage) ──
  var CART_KEY="uw_cart";
  function getCart(){ try{ return JSON.parse(localStorage.getItem(CART_KEY))||{}; }catch(e){ return {}; } }
  function saveCart(c){ localStorage.setItem(CART_KEY, JSON.stringify(c)); refresh(); }
  function itemInfo(key){ if(key==="col-intro") return {label:"Набор «Первое знакомство»", sub:"3 банки × 250 г", price:1490};
    var a=key.split("|"), p=P[a[0]]; return p?{label:p.n, sub:a[1]+" г", price:p.pr[a[1]]}:null; }
  function addToCart(key){ var c=getCart(); c[key]=(c[key]||0)+1; saveCart(c); toast("Добавлено в корзину ✓"); }
  function setQty(key,q){ var c=getCart(); if(q<=0) delete c[key]; else c[key]=q; saveCart(c); if(document.getElementById("view-cart").classList.contains("active")) renderCart(); }
  function lines(){ var c=getCart(); return Object.keys(c).map(function(k){ var i=itemInfo(k); return i?{key:k,q:c[k],label:i.label,sub:i.sub,price:i.price,sum:i.price*c[k]}:null; }).filter(Boolean); }
  function cartCount(){ return lines().reduce(function(s,l){return s+l.q;},0); }
  function cartTotal(){ return lines().reduce(function(s,l){return s+l.sum;},0); }
  function refresh(){ document.getElementById("badge").textContent = cartCount(); }

  function renderCart(){
    var L=lines(), body=document.getElementById("cart-body");
    if(!L.length){ body.innerHTML='<div class="empty"><div class="big">🧺</div><b style="font-size:17px">Пока пусто</b><p style="margin-top:6px">Выберите вкус в каталоге.</p><button class="btn btn-green" style="margin-top:16px" data-go="catalog">В каталог</button></div>'; return; }
    body.innerHTML = L.map(function(l){ return '<div class="row-item"><div class="nm">'+l.label+'<small>'+l.sub+' · '+money(l.price)+'</small></div>'+
      '<div class="qty"><button data-q="'+l.key+'|-1">−</button><b>'+l.q+'</b><button data-q="'+l.key+'|1">+</button></div></div>'; }).join("")
      + '<div style="display:flex;justify-content:space-between;align-items:center;padding:14px 4px"><b>Итого</b><span class="price">'+money(cartTotal())+'</span></div>'
      + '<button class="btn btn-green btn-block" data-go="checkout">Оформить заказ</button>';
  }
  function renderCheckout(){
    var L=lines(), body=document.getElementById("checkout-body");
    if(!L.length){ body.innerHTML='<div class="empty"><b>Корзина пуста</b><button class="btn btn-green" style="margin-top:16px" data-go="catalog">В каталог</button></div>'; return; }
    body.innerHTML='<div class="info" style="margin-bottom:14px">'+L.map(function(l){return '<div class="row"><div style="flex:1"><b>'+l.label+' · '+l.sub+' × '+l.q+'</b></div><b>'+money(l.sum)+'</b></div>';}).join("")
      +'<div class="row"><div style="flex:1"><b>Итого + доставка</b></div><b class="price" style="font-size:20px">'+money(cartTotal())+'</b></div></div>'
      +'<form id="order-form">'
      +'<label class="fld">Имя<input name="name" required placeholder="Как к вам обращаться"></label>'
      +'<label class="fld">Телефон<input name="phone" type="tel" required placeholder="+7 ___ ___-__-__"></label>'
      +'<label class="fld">Город<input name="city" required placeholder="Например: Махачкала"></label>'
      +'<label class="fld">Пункт выдачи Ozon / адрес<input name="pvz" required placeholder="Адрес доставки"></label>'
      +'<button class="btn btn-green btn-block" type="submit">Отправить заказ</button>'
      +'<p style="text-align:center;color:var(--muted);font-size:12px;margin-top:10px">Оплату и точную доставку подтвердим после заказа.</p></form>';
    document.getElementById("order-form").addEventListener("submit", function(e){
      e.preventDefault();
      var fd=new FormData(e.target), L2=lines(), total=cartTotal();
      var orders=[]; try{ orders=JSON.parse(localStorage.getItem("urbawild_orders"))||[]; }catch(x){}
      orders.unshift({ id:Date.now(), date:new Date().toLocaleString("ru-RU"),
        name:fd.get("name")||"", phone:fd.get("phone")||"", city:fd.get("city")||"", pvz:fd.get("pvz")||"",
        items:L2.map(function(l){return {label:l.label+" "+l.sub, qty:l.q, sum:l.sum};}),
        total:total, status:"new", pay:"тест (СБП подключим)" });
      localStorage.setItem("urbawild_orders", JSON.stringify(orders));
      var wa="Новый заказ URBAWILD:%0A%0A"+L2.map(function(l){return "• "+l.label+" "+l.sub+" × "+l.q+" — "+money(l.sum);}).join("%0A")
        +"%0A%0AИтого: "+money(total)+"%0AИмя: "+(fd.get("name")||"")+"%0AТелефон: "+(fd.get("phone")||"")+"%0AГород: "+(fd.get("city")||"")+"%0AПВЗ: "+(fd.get("pvz")||"");
      saveCart({});
      document.getElementById("checkout-body").innerHTML='<div class="empty"><div class="big" style="color:var(--green)">✓</div>'
        +'<b style="font-size:20px;color:var(--green)">Заказ оформлен</b><p style="margin-top:8px">Спасибо! Мы свяжемся с вами для подтверждения и доставки.</p>'
        +'<a class="btn btn-green btn-block" style="margin-top:16px" target="_blank" rel="noopener" href="https://wa.me/79882754421?text='+wa+'">Продублировать в WhatsApp</a>'
        +'<button class="btn btn-out btn-block" style="margin-top:10px" data-go="home">На главную</button></div>';
    });
  }

  var pmSize=250;
  function openProduct(id){ var p=P[id]; pmSize=250;
    document.getElementById("pd").innerHTML =
      '<div class="art"><div class="back" data-go="catalog">‹</div>'+jar(id,true)+'</div>'+
      '<div class="pd-b"><h2>'+p.n+'</h2><div class="w">Натуральный дагестанский урбеч</div>'+
      '<div class="sizes" id="sizes">'+[250,450,1000].map(function(s){return '<div class="size'+(s===250?' on':'')+'" data-size="'+s+'"><b>'+(s===1000?"1 кг":s+" г")+'</b><span>'+money(p.pr[s])+'</span></div>';}).join("")+'</div>'+
      '<div class="pd-price" id="pd-price">'+money(p.pr[250])+'</div>'+
      '<button class="btn btn-green btn-block" id="pd-add">Добавить в корзину</button>'+
      '<div class="block" style="margin-top:14px"><h4>Вкус</h4><p>'+p.d+'</p></div>'+
      '<div class="block"><h4>Состав</h4><p>100% натуральный урбеч. Без лишних добавок.</p></div>'+
      '<div class="block"><h4>С чем едят</h4><p>'+p.eat+'</p></div></div>';
    document.getElementById("sizes").addEventListener("click", function(e){ var b=e.target.closest(".size"); if(!b)return;
      document.querySelectorAll("#sizes .size").forEach(function(x){x.classList.remove("on");}); b.classList.add("on");
      pmSize=+b.getAttribute("data-size"); document.getElementById("pd-price").textContent=money(p.pr[pmSize]); });
    document.getElementById("pd-add").addEventListener("click", function(){ addToCart(id+"|"+pmSize); });
    go("product");
  }

  function go(v){ document.querySelectorAll(".screen").forEach(function(s){s.classList.remove("active");});
    document.getElementById("view-"+v).classList.add("active");
    ["home","catalog","cart"].forEach(function(n){ var el=document.getElementById("nav-"+n); if(el) el.classList.toggle("on", n===v || (v==="checkout"&&n==="cart")); });
    if(v==="cart") renderCart(); if(v==="checkout") renderCheckout();
    window.scrollTo(0,0); }

  function toast(m){ var t=document.getElementById("toast"); t.textContent=m; t.classList.add("show"); clearTimeout(toast._t); toast._t=setTimeout(function(){t.classList.remove("show");},1600); }

  var ov=document.getElementById("overlay"), ms=document.getElementById("menu-sheet");
  function openMenu(){ ov.classList.add("show"); ms.classList.add("show"); }
  function closeMenu(){ ov.classList.remove("show"); ms.classList.remove("show"); }
  document.getElementById("menu-btn").addEventListener("click", openMenu);
  ov.addEventListener("click", closeMenu);

  document.addEventListener("click", function(e){
    var g=e.target.closest("[data-go]"); if(g){ if(g.closest(".sheet")) closeMenu(); go(g.getAttribute("data-go")); return; }
    var o=e.target.closest("[data-open]"); if(o){ openProduct(o.getAttribute("data-open")); return; }
    var a=e.target.closest("[data-add]"); if(a){ addToCart(a.getAttribute("data-add")); return; }
    var q=e.target.closest("[data-q]"); if(q){ var pr=q.getAttribute("data-q").split("|"), d=+pr.pop(), k=pr.join("|"); setQty(k,(getCart()[k]||0)+d); return; }
  });
  refresh();
</script>
