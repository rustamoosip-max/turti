<style>
  *,*::before,*::after{ box-sizing:border-box; margin:0; padding:0; }
  :root{
    --milk:#F6F1E7; --paper:#FFFFFF; --green:#1E3B2C; --green2:#2C5240;
    --nut:#B98A5E; --gold:#C7A24B; --ink:#20261F; --muted:#6E6A5F;
    --line:#E9E2D3; --shadow:0 14px 34px rgba(31,45,33,.10);
  }
  html{ scroll-behavior:smooth; }
  body{ font-family:'Manrope',sans-serif; color:var(--ink); background:var(--milk);
    -webkit-font-smoothing:antialiased; line-height:1.5; }
  h1,h2,h3,.logo-txt{ font-family:'Cormorant Garamond',serif; font-weight:600; }
  a{ color:inherit; }
  .app{ max-width:480px; margin:0 auto; background:var(--milk); min-height:100vh; position:relative; overflow-x:hidden; }
  .screen{ display:none; padding-bottom:96px; }
  .screen.active{ display:block; }

  .hdr{ position:sticky; top:0; z-index:30; display:flex; align-items:center; justify-content:space-between;
    padding:12px 16px; background:rgba(246,241,231,.85); -webkit-backdrop-filter:blur(16px); backdrop-filter:blur(16px);
    border-bottom:1px solid var(--line); }
  .hdr .ic{ width:40px; height:40px; border-radius:12px; border:1px solid var(--line); background:var(--paper);
    display:grid; place-items:center; color:var(--green); cursor:pointer; }
  .hdr .ic svg{ width:20px; height:20px; }
  .logo{ display:flex; flex-direction:column; align-items:center; line-height:1; text-decoration:none; cursor:pointer; }
  .logo .logo-txt{ font-size:23px; letter-spacing:.04em; color:var(--green); }
  .logo small{ font-size:8.5px; letter-spacing:.26em; text-transform:uppercase; color:var(--nut); font-weight:700; margin-top:2px; }
  .cart-ic{ position:relative; }
  .badge{ position:absolute; top:-6px; right:-6px; min-width:18px; height:18px; padding:0 4px; background:var(--green);
    color:#fff; font:800 10px 'Manrope',sans-serif; border-radius:999px; display:grid; place-items:center; }

  .btn{ display:inline-flex; align-items:center; justify-content:center; gap:8px; min-height:52px; padding:14px 26px;
    border:none; border-radius:16px; cursor:pointer; font:800 15px 'Manrope',sans-serif; text-decoration:none;
    transition:transform .15s, filter .15s; }
  .btn:active{ transform:scale(.98); }
  .btn-green{ background:var(--green); color:#F6F1E7; box-shadow:0 10px 24px rgba(30,59,44,.28); }
  .btn-green:hover{ filter:brightness(1.08); }
  .btn-out{ background:transparent; color:var(--green); border:1.5px solid var(--green); }
  .btn-cream{ background:#F6F1E7; color:var(--green); }
  .btn-sm{ min-height:44px; padding:10px 16px; font-size:13.5px; border-radius:13px; }
  .btn-block{ width:100%; }

  .hero{ position:relative; height:66vh; min-height:480px; overflow:hidden; display:flex; align-items:flex-end; }
  .hero img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .hero .fallback{ position:absolute; inset:0; background:linear-gradient(160deg,#3C6B4E,#1E3B2C 60%,#132619); }
  .hero .shade{ position:absolute; inset:0; background:linear-gradient(to top, rgba(12,22,15,.9) 6%, rgba(12,22,15,.4) 48%, rgba(12,22,15,.08)); }
  .hero-in{ position:relative; z-index:2; padding:0 20px 28px; width:100%; }
  .hero h1{ color:#FBF7EE; font-size:41px; line-height:1.04; margin-bottom:10px; text-shadow:0 4px 22px rgba(0,0,0,.4); }
  .hero p{ color:rgba(251,247,238,.92); font-size:15px; font-weight:500; margin-bottom:18px; max-width:300px; }
  .trust{ display:inline-flex; align-items:center; gap:8px; margin-top:14px; background:rgba(255,255,255,.14);
    border:1px solid rgba(255,255,255,.25); color:#FBF7EE; font-size:11.5px; font-weight:700; padding:8px 13px;
    border-radius:999px; -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px); }

  .sec{ padding:30px 16px 6px; }
  .sec-h{ display:flex; align-items:baseline; justify-content:space-between; margin-bottom:14px; }
  .sec-h h2{ font-size:27px; color:var(--green); }
  .eyebrow{ display:block; font:700 11px 'Manrope',sans-serif; letter-spacing:.18em; text-transform:uppercase; color:var(--nut); margin-bottom:3px; }
  .sec-h a{ font:700 13px 'Manrope',sans-serif; color:var(--green); text-decoration:none; white-space:nowrap; cursor:pointer; }

  .jar{ position:relative; width:76px; height:104px; border-radius:9px 9px 13px 13px; flex-shrink:0;
    box-shadow:inset 0 -14px 24px rgba(0,0,0,.18), 0 8px 16px rgba(30,40,25,.16); }
  .jar::before{ content:""; position:absolute; top:-7px; left:50%; transform:translateX(-50%); width:64%; height:11px; background:#2A2118; border-radius:4px 4px 3px 3px; }
  .jar::after{ content:""; position:absolute; top:26%; left:12%; right:12%; bottom:16%; background:rgba(252,249,242,.94); border-radius:7px; }
  .jar span{ position:absolute; z-index:2; left:0; right:0; top:40%; text-align:center; font:800 9px 'Manrope',sans-serif; letter-spacing:.06em; padding:0 6px; line-height:1.2; }

  .bundle{ background:var(--paper); border:1px solid var(--line); border-radius:24px; overflow:hidden; box-shadow:var(--shadow); }
  .bundle-top{ position:relative; background:linear-gradient(150deg,#EFE7D5,#E4D6BC); padding:26px 18px 20px; display:flex; align-items:flex-end; justify-content:center; gap:8px; }
  .bundle-top .jar{ width:66px; height:92px; }
  .bundle-top .jar:nth-child(3){ transform:translateY(-10px); z-index:2; }
  .tag{ position:absolute; top:12px; left:14px; background:var(--green); color:#F6F1E7; font:800 11px 'Manrope',sans-serif; padding:6px 11px; border-radius:999px; }
  .bundle-b{ padding:18px; }
  .bundle-b h3{ font-size:24px; color:var(--green); margin-bottom:4px; }
  .bundle-b .fl{ color:var(--muted); font-size:13.5px; font-weight:500; margin-bottom:12px; }
  .price-row{ display:flex; align-items:baseline; gap:10px; margin-bottom:14px; }
  .price{ font:800 26px 'Manrope',sans-serif; color:var(--green); letter-spacing:-.02em; }
  .price-old{ color:#B3AB97; text-decoration:line-through; font-size:15px; font-weight:600; }
  .price-save{ background:#EAF1EA; color:var(--green2); font:800 11px 'Manrope',sans-serif; padding:4px 10px; border-radius:999px; }

  .hscroll{ display:flex; gap:12px; overflow-x:auto; padding:2px 16px 14px; scroll-snap-type:x mandatory; }
  .hscroll::-webkit-scrollbar{ display:none; }
  .hcard{ scroll-snap-align:start; flex:0 0 156px; }

  .pcard{ background:var(--paper); border:1px solid var(--line); border-radius:20px; overflow:hidden; box-shadow:0 8px 20px rgba(31,45,33,.07); display:flex; flex-direction:column; }
  .pcard .art{ position:relative; height:150px; display:flex; align-items:flex-end; justify-content:center; padding-bottom:16px; background:radial-gradient(120% 90% at 50% 20%, #FBF7EE, #F1EAD9); cursor:pointer; }
  .pcard .art::after{ content:""; position:absolute; bottom:12px; left:26%; right:26%; height:11px; border-radius:50%; background:rgba(0,0,0,.14); filter:blur(6px); }
  .pcard .art .jar{ width:64px; height:88px; z-index:2; }
  .pcard .b{ padding:12px 13px 13px; display:flex; flex-direction:column; gap:2px; flex:1; }
  .pcard .b h3{ font-family:'Manrope',sans-serif; font-weight:800; font-size:14.5px; color:var(--ink); line-height:1.25; }
  .pcard .b .w{ font-size:11.5px; color:var(--muted); font-weight:600; }
  .pcard .b .pr{ font:800 17px 'Manrope',sans-serif; color:var(--green); letter-spacing:-.02em; margin-top:4px; }
  .pcard .add{ margin-top:10px; }
  .grid2{ display:grid; grid-template-columns:1fr 1fr; gap:12px; padding:0 16px; }

  .mill{ margin:30px 16px 6px; border-radius:24px; overflow:hidden; position:relative; min-height:300px; display:flex; align-items:flex-end; box-shadow:var(--shadow); }
  .mill img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .mill .fallback{ position:absolute; inset:0; background:linear-gradient(160deg,#5A3A1E,#241608); }
  .mill .shade{ position:absolute; inset:0; background:linear-gradient(to top, rgba(15,25,15,.92) 8%, rgba(15,25,15,.35) 60%); }
  .mill-in{ position:relative; z-index:2; padding:22px 20px; }
  .mill-in .eyebrow{ color:var(--gold); }
  .mill-in h2{ color:#FBF7EE; font-size:28px; line-height:1.1; margin-bottom:8px; }
  .mill-in p{ color:rgba(251,247,238,.9); font-size:14px; font-weight:500; margin-bottom:16px; max-width:290px; }

  .review{ background:var(--paper); border:1px solid var(--line); border-radius:18px; padding:16px; margin-bottom:12px; box-shadow:0 6px 16px rgba(31,45,33,.05); }
  .review .top{ display:flex; align-items:center; gap:10px; margin-bottom:8px; }
  .ava{ width:38px; height:38px; border-radius:50%; background:var(--green); color:#F6F1E7; display:grid; place-items:center; font:800 15px 'Manrope',sans-serif; }
  .review .top b{ font-size:14px; }
  .stars{ color:var(--gold); font-size:12px; letter-spacing:2px; }
  .review p{ font-size:13.5px; color:#4A473E; font-weight:500; line-height:1.55; }

  .info{ background:var(--paper); border:1px solid var(--line); border-radius:18px; padding:16px; }
  .info .row{ display:flex; gap:12px; padding:10px 0; border-top:1px solid var(--line); }
  .info .row:first-child{ border-top:none; }
  .info .row .i{ font-size:20px; }
  .info .row b{ font-size:14px; display:block; }
  .info .row span{ font-size:12.5px; color:var(--muted); }

  .foot{ background:var(--green); color:rgba(246,241,231,.85); padding:28px 20px 26px; margin-top:30px; }
  .foot .logo-txt{ color:#F6F1E7; font-size:24px; }
  .foot .links{ display:flex; flex-wrap:wrap; gap:10px; margin:14px 0; }
  .foot .links a{ background:rgba(246,241,231,.12); color:#F6F1E7; text-decoration:none; font:700 12.5px 'Manrope',sans-serif; padding:9px 14px; border-radius:999px; cursor:pointer; }
  .foot .sm{ font-size:11.5px; color:rgba(246,241,231,.6); line-height:1.7; }

  .nav{ position:fixed; left:50%; transform:translateX(-50%); bottom:0; z-index:40; width:100%; max-width:480px; height:74px;
    background:rgba(246,241,231,.94); -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); border-top:1px solid var(--line); display:flex; }
  .nav button{ flex:1; background:none; border:none; cursor:pointer; display:grid; justify-items:center; gap:3px; font:800 10.5px 'Manrope',sans-serif; color:#9A9484; }
  .nav button svg{ width:24px; height:24px; }
  .nav button.on{ color:var(--green); }

  .pd .art{ height:300px; background:radial-gradient(120% 80% at 50% 25%, #FBF7EE, #EEE5D2); display:flex; align-items:flex-end; justify-content:center; padding-bottom:26px; position:relative; }
  .pd .art .jar{ width:120px; height:164px; }
  .pd .art .back{ position:absolute; top:14px; left:14px; width:40px; height:40px; border-radius:12px; background:rgba(255,255,255,.9); border:1px solid var(--line); display:grid; place-items:center; cursor:pointer; font-size:20px; color:var(--green); }
  .pd-b{ padding:20px 18px; }
  .pd-b h2{ font-size:30px; color:var(--green); margin-bottom:4px; }
  .pd-b .w{ color:var(--muted); font-weight:600; font-size:14px; margin-bottom:14px; }
  .sizes{ display:flex; gap:8px; margin-bottom:16px; }
  .size{ flex:1; border:1.5px solid var(--line); background:var(--paper); border-radius:14px; padding:10px 6px; text-align:center; cursor:pointer; }
  .size.on{ border-color:var(--green); background:#EAF1EA; }
  .size b{ display:block; font:800 14px 'Manrope',sans-serif; }
  .size span{ font-size:12px; color:var(--muted); }
  .pd-price{ font:800 30px 'Manrope',sans-serif; color:var(--green); letter-spacing:-.02em; margin:6px 0 16px; }
  .block{ background:var(--paper); border:1px solid var(--line); border-radius:16px; padding:14px 16px; margin-bottom:10px; }
  .block h4{ font:800 11px 'Manrope',sans-serif; letter-spacing:.14em; text-transform:uppercase; color:var(--nut); margin-bottom:6px; }
  .block p{ font-size:14px; color:#4A473E; font-weight:500; }

  .row-item{ background:var(--paper); border:1px solid var(--line); border-radius:16px; padding:12px 14px; display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; }
  .row-item .nm{ font-weight:800; font-size:14px; }
  .row-item .nm small{ display:block; color:var(--muted); font-weight:600; font-size:12px; }
  .qty{ display:flex; align-items:center; gap:6px; }
  .qty button{ width:32px; height:32px; border-radius:9px; border:1.5px solid var(--line); background:var(--paper); font:800 17px 'Manrope',sans-serif; color:var(--green); cursor:pointer; }
  .qty b{ min-width:22px; text-align:center; }
  .fld{ display:grid; gap:6px; margin-bottom:10px; font:800 13px 'Manrope',sans-serif; color:#3f3a30; }
  .fld input{ border:1.5px solid var(--line); border-radius:13px; padding:13px 14px; font:500 16px 'Manrope',sans-serif; outline:none; background:var(--paper); }
  .fld input:focus{ border-color:var(--green); }
  .empty{ text-align:center; color:var(--muted); padding:60px 20px; }
  .empty .big{ font-size:40px; margin-bottom:10px; }

  .overlay{ position:fixed; inset:0; z-index:50; background:rgba(20,16,10,.5); opacity:0; visibility:hidden; transition:.25s; }
  .overlay.show{ opacity:1; visibility:visible; }
  .sheet{ position:fixed; left:50%; transform:translateX(-50%) translateY(105%); bottom:0; width:100%; max-width:480px; z-index:60;
    background:var(--milk); border-radius:26px 26px 0 0; padding:18px 18px 30px; transition:transform .3s cubic-bezier(.3,1,.4,1); }
  .sheet.show{ transform:translateX(-50%); }
  .grip{ width:44px; height:5px; border-radius:99px; background:#D8CFBC; margin:0 auto 14px; }
  .menu a{ display:block; background:var(--paper); border:1px solid var(--line); border-radius:14px; padding:15px 16px; font:800 15px 'Manrope',sans-serif; color:var(--ink); text-decoration:none; margin-bottom:8px; cursor:pointer; }
  .toast{ position:fixed; left:50%; transform:translateX(-50%) translateY(16px); bottom:92px; z-index:80; background:var(--green); color:#F6F1E7; padding:12px 22px; border-radius:999px; font:700 14px 'Manrope',sans-serif; opacity:0; transition:.25s; pointer-events:none; }
  .toast.show{ opacity:1; transform:translateX(-50%); }
</style>
</head>
