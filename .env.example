# TURTI — переменные окружения Vercel
# НЕ коммить реальные ключи в GitHub.

# Публичный адрес сайта
PUBLIC_SITE_URL=https://turti-compani.vercel.app

# Адрес, откуда курьер Яндекса забирает готовый заказ
TURTI_PICKUP_CITY=Махачкала
TURTI_PICKUP_ADDRESS=

# CDEK API v2 — выдаются в личном кабинете/по договору
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# можно не указывать — сервер сам найдёт код Махачкалы
CDEK_FROM_CITY_CODE=

# Яндекс Доставка для бизнеса
YANDEX_DELIVERY_TOKEN=

# ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Telegram-уведомления владельцу TURTI
TG_BOT_TOKEN=
TG_CHAT_ID=

# Ozon — добавим после онбординга Ozon Pay / Ozon Доставки
OZON_CLIENT_ID=
OZON_CLIENT_SECRET=
