<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="URBAWILD — натуральный урбеч из Дагестана. Без лишних добавок, сделан на водяной мельнице в горах Кавказа.">
  <title>URBAWILD — настоящий урбеч из Дагестана</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Prata&family=Archivo+Black&family=Playfair+Display:wght@800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --green: #C6362B;        /* фирменный красный — главный акцент (имя переменной старое) */
      --green-dark: #9E271F;
      --cream: #F7F0E3;        /* кремовый фон */
      --nut: #C89B6A;          /* ореховый */
      --gold: #C6362B;         /* тёплое золото — вторичный акцент (имя переменной старое) */
      --ink: #1B1B18;
      --gray: #6F6B60;
      --line: #E9E2D3;
      --white: #ffffff;
    }

    html { scroll-behavior: smooth; }
    body {
      font-family: 'Manrope', sans-serif; background: var(--cream); color: var(--ink);
      -webkit-font-smoothing: antialiased; font-size: 16px; line-height: 1.65;
    }
    body.locked { overflow: hidden; }
    h1,h2,h3 { font-family: 'Prata', serif; font-weight: 400; }
    button { font: inherit; cursor: pointer; }
    a { color: inherit; }

    /* ═══ КНОПКИ — крупные, под палец ═══ */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      min-height: 48px; padding: 12px 22px; border: none; border-radius: 999px;
      font-weight: 800; font-size: 15px; text-decoration: none; transition: transform .18s, box-shadow .18s, background .18s;
    }
    .btn:active { transform: scale(.97); }
    .btn-green { background: linear-gradient(180deg, #E0574C 0%, var(--green) 55%, #9E271F 100%); color: #fff; box-shadow: 0 8px 22px rgba(158,39,31,.32), inset 0 1px 0 rgba(255,255,255,.3); }
    .btn-green:hover { background: var(--green-dark); }
    .btn-gold { background: var(--gold); color: #fff; box-shadow: 0 8px 22px rgba(198,54,43,.4); }
    .btn-gold:hover { filter: brightness(1.05); }
    .btn-outline { background: transparent; color: var(--green); border: 2px solid var(--green); }
    .btn-outline:hover { background: rgba(23,131,184,.08); }
    .btn-white { background: #fff; color: var(--green); box-shadow: 0 10px 26px rgba(0,0,0,.2); }
    .btn-sm { min-height: 40px; padding: 9px 15px; font-size: 13px; }
    .pcard-actions .btn { min-height: 40px; font-size: 13px; padding: 8px 12px; }
    .two-btns .btn { min-height: 44px; font-size: 14px; }
    .btn-block { width: 100%; }

    /* ═══ ШАПКА ═══ */
    .header {
      position: sticky; top: 0; z-index: 60;
      display: flex; align-items: center; justify-content: space-between;
      padding: 10px 16px;
      background: rgba(247,240,227,.78);
      backdrop-filter: blur(22px) saturate(1.6);
      -webkit-backdrop-filter: blur(22px) saturate(1.6);
      border-bottom: 1px solid rgba(255,255,255,.6);
      box-shadow: 0 1px 0 rgba(120,90,40,.08);
    }
    .logo { display: flex; align-items: center; gap: 11px; text-decoration: none; }
    .logo-mark {
      width: 42px; height: 42px; border-radius: 13px;
      background: linear-gradient(160deg, #E0574C 0%, #C6362B 55%, #7E1D16 100%);
      display: grid; place-items: center;
      box-shadow: 0 6px 14px rgba(15,95,136,.35), inset 0 1.5px 2px rgba(255,255,255,.5);
    }
    .logo strong {
      font-family: 'Archivo Black', 'Manrope', sans-serif;
      font-size: 16.5px; letter-spacing: .07em;
      background: linear-gradient(180deg, #7E1D16 0%, #B22C22 60%, #C6362B 100%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
      text-shadow: 0 1px 0 rgba(255,255,255,.35);
    }
    .logo small { display: block; font-size: 9.5px; color: var(--gray); font-weight: 700; letter-spacing: .07em; }
    .cart-glass {
      position: relative;
      width: 44px; height: 44px; border-radius: 14px;
      background: rgba(255,255,255,.68);
      border: 1px solid rgba(255,255,255,.8);
      box-shadow: 0 4px 12px rgba(120,90,40,.14), inset 0 1px 0 rgba(255,255,255,.9);
      display: grid; place-items: center; color: var(--green-dark);
      transition: transform .15s;
    }
    .cart-glass:active { transform: scale(.9); }
    .cart-glass svg { width: 24px; height: 24px; display: block; }
    .cart-glass .dock-badge { top: -6px; right: -6px; }

    /* ═══ HERO ═══ */
    .hero {
      position: relative; min-height: 88svh; display: flex; flex-direction: column;
      align-items: center; justify-content: flex-end; overflow: hidden;
      padding: 0 20px 44px; text-align: center;
    }
    .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center top; }
    .hero-fallback { position: absolute; inset: 0; background: linear-gradient(160deg, #F8D9A0 0%, #E7C98A 55%, #C9B79A 100%); }
    .hero-scene { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
    .hero-shade { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(15,25,18,0) 30%, rgba(15,25,18,.72) 100%); }
    .hero-content { position: relative; z-index: 2; max-width: 640px; animation: rise .8s ease both; }
    @keyframes rise { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }
    .hero-title {
      font-family: 'Playfair Display', 'Prata', serif; font-weight: 800;
      font-size: clamp(34px, 8.5vw, 54px); line-height: 1.12;
      color: #FFFDF6; letter-spacing: .01em;
      text-shadow: 0 5px 30px rgba(0,0,0,.55), 0 2px 5px rgba(0,0,0,.4);
      margin: 0;
    }
    .hero-sub {
      color: rgba(255,252,244,.95); font-size: clamp(15px, 4vw, 18px);
      margin: 12px auto 28px; max-width: 460px; font-weight: 600;
      text-shadow: 0 2px 12px rgba(0,0,0,.4);
    }
    .hero-btns { display: flex; flex-direction: column; gap: 12px; width: 100%; max-width: 380px; margin: 0 auto; }

    /* ═══ ДОВЕРИЕ ═══ */
    .trust-strip {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px;
      background: var(--line); border-bottom: 1px solid var(--line);
    }
    .trust-strip div { background: var(--cream); padding: 18px 12px; text-align: center; }
    .trust-strip strong { font-family: 'Prata', serif; font-size: 26px; color: var(--green); display: block; }
    .trust-strip span { font-size: 12.5px; color: var(--gray); font-weight: 700; }

    /* ═══ СЕКЦИИ ═══ */
    .section { padding: 60px 18px; max-width: 1100px; margin: 0 auto; }
    .sec-head { text-align: center; max-width: 620px; margin: 0 auto 30px; }
    .eyebrow { font-size: 12px; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; color: var(--nut); display: block; margin-bottom: 10px; }
    .sec-title { font-size: clamp(27px, 6vw, 44px); line-height: 1.1; margin-bottom: 12px; }
    .sec-lead { color: var(--gray); font-size: 15.5px; }

    /* ═══ БАНКА (CSS) ═══ */
    .jar { position: relative; display: flex; flex-direction: column; border-radius: 10px 10px 14px 14px; overflow: hidden; border: 2.5px solid rgba(255,255,255,.65); background: rgba(255,255,255,.2); flex-shrink: 0; }
    .jar-lid { height: 14%; background: rgba(43,35,25,.85); border-bottom: 2px solid rgba(255,255,255,.35); }
    .jar-body { flex: 1; display: flex; align-items: center; justify-content: center; padding: 8%; }
    .jar-tag { background: rgba(250,246,238,.95); border-radius: 6px; padding: 6% 8%; text-align: center; width: 92%; }
    .jar-tag span { display: block; font-size: 8px; font-weight: 800; letter-spacing: .14em; color: #9a927e; }
    .jar-tag strong { display: block; font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 11px; line-height: 1.25; margin-top: 3px; color: var(--ink); }

    /* ═══ НАБОР «ПЕРВОЕ ЗНАКОМСТВО» ═══ */
    .intro-card {
      background: var(--white); border: 1.5px solid var(--line); border-radius: 28px; overflow: hidden;
      box-shadow: 0 20px 50px rgba(60,45,20,.1);
    }
    .intro-box {
      position: relative; background: linear-gradient(150deg, #F1E7D2, #E4D4B4);
      padding: 36px 20px 30px; display: flex; align-items: flex-end; justify-content: center; gap: 10px; min-height: 240px;
    }
    .intro-box::before {
      content: "КОРОБКА URBAWILD"; position: absolute; top: 16px; left: 50%; transform: translateX(-50%);
      font-size: 10px; font-weight: 800; letter-spacing: .3em; color: #8A7A57;
    }
    .intro-box::after {
      content: ""; position: absolute; bottom: 18px; left: 12%; right: 12%; height: 30px;
      background: #C9B18D; border-radius: 6px;
    }
    .intro-box .jar { width: 84px; height: 118px; z-index: 2; }
    .intro-box .jar:nth-child(2) { transform: translateY(-10px); }
    .intro-badge {
      position: absolute; top: 14px; right: 14px; z-index: 3;
      background: var(--gold); color: #fff; font-size: 11px; font-weight: 800;
      border-radius: 999px; padding: 7px 13px; box-shadow: 0 6px 14px rgba(69,174,221,.4);
    }
    .intro-info { padding: 24px 20px 26px; }
    .intro-info h3 { font-size: 25px; margin-bottom: 8px; }
    .intro-info > p { color: var(--gray); font-size: 15px; margin-bottom: 16px; }
    .intro-list { list-style: none; display: grid; gap: 8px; margin-bottom: 18px; }
    .intro-list li { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 15px; }
    .intro-list li::before { content: "✓"; color: var(--green); font-weight: 800; }
    .price-row { display: flex; align-items: baseline; gap: 10px; margin-bottom: 18px; }
    .price-now { font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 28px; letter-spacing: -.02em; color: var(--green); }
    .price-old { color: #A99; text-decoration: line-through; font-size: 16px; }
    .price-save { background: #EAF3EA; color: var(--green); font-size: 12px; font-weight: 800; border-radius: 999px; padding: 4px 10px; }
    .two-btns { display: grid; gap: 10px; }

    /* ═══ КАРТОЧКИ ТОВАРОВ ═══ */
    .hits-scroll { display: flex; gap: 14px; overflow-x: auto; padding: 4px 2px 16px; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; }
    .hits-scroll::-webkit-scrollbar { display: none; }
    .hits-scroll .pcard { min-width: 258px; scroll-snap-align: start; }

    .catalog-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    @media (max-width: 380px) { .catalog-grid { grid-template-columns: 1fr; } }

    .pcard {
      background: var(--white); border: 1.5px solid var(--line); border-radius: 22px; overflow: hidden;
      display: flex; flex-direction: column; transition: transform .2s, box-shadow .2s, border-color .2s;
      box-shadow: 0 10px 26px rgba(110,80,30,.12);
    }
    .pcard:hover { border-color: rgba(198,54,43,.35); }
    .pcard:active { transform: scale(.97); }
    .pcard:hover { box-shadow: 0 14px 34px rgba(110,80,30,.14); }
    .pcard-art { position: relative; min-height: 190px; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 20px; cursor: pointer; }
    .pcard-art::after { content: ""; position: absolute; bottom: 10px; left: 24%; right: 24%; height: 14px; border-radius: 50%; background: rgba(0,0,0,.16); filter: blur(7px); }
    .pcard-art .jar { width: 96px; height: 128px; z-index: 2; transition: transform .25s; }
    .pcard:hover .pcard-art .jar { transform: translateY(-5px); }
    .pcard-badge { position: absolute; top: 12px; left: 12px; z-index: 3; background: var(--green); color: #fff; border-radius: 999px; padding: 6px 12px; font-size: 11px; font-weight: 800; box-shadow: 0 6px 14px rgba(198,54,43,.35); }
    .pcard-body { padding: 14px 14px 16px; flex: 1; display: flex; flex-direction: column; }
    .pcard-body h3 { font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 16.5px; line-height: 1.3; margin-bottom: 6px; }
    .pcard-desc { font-size: 13.5px; color: var(--gray); line-height: 1.55; flex: 1; margin-bottom: 10px; }
    .pcard-sizes { display: flex; gap: 5px; margin-bottom: 10px; flex-wrap: wrap; }
    .pcard-sizes span { font-size: 11px; font-weight: 700; color: var(--gray); border: 1px solid var(--line); border-radius: 999px; padding: 3px 9px; }
    .pcard-price { font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 20px; letter-spacing: -.02em; color: var(--green); margin-bottom: 11px; }
    .pcard-price small { font-family: 'Manrope', sans-serif; font-size: 11.5px; color: var(--gray); font-weight: 600; }
    .pcard-actions { display: grid; gap: 8px; }

    /* ═══ КОЛЛЕКЦИИ ═══ */
    .collections { display: grid; gap: 16px; }
    .col-card {
      background: var(--white); border: 1.5px solid var(--line); border-radius: 24px; overflow: hidden;
      box-shadow: 0 12px 34px rgba(60,45,20,.08);
    }
    .col-box {
      position: relative; padding: 34px 16px 24px; min-height: 170px;
      display: flex; align-items: flex-end; justify-content: center; gap: 6px;
      background: linear-gradient(150deg, #F3EAD8, #E6D7B8);
    }
    .col-box::before {
      content: "ФИРМЕННАЯ КОРОБКА URBAWILD"; position: absolute; top: 12px; left: 50%; transform: translateX(-50%);
      font-size: 9px; font-weight: 800; letter-spacing: .26em; color: #8A7A57; white-space: nowrap;
    }
    .col-box .jar { width: 56px; height: 78px; z-index: 2; }
    .col-box .jar .jar-tag strong { font-size: 8px; }
    .col-box .jar .jar-tag span { font-size: 6px; }
    .col-badge { position: absolute; top: 10px; right: 12px; z-index: 3; background: var(--gold); color: #fff; font-size: 10.5px; font-weight: 800; border-radius: 999px; padding: 6px 11px; }
    .col-info { padding: 18px 18px 20px; }
    .col-info h3 { font-size: 21px; margin-bottom: 6px; }
    .col-flavors { font-size: 13px; color: var(--gray); margin-bottom: 12px; line-height: 1.55; }
    .col-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 14px; }

    /* ═══ ПАРТНЁРАМ ═══ */
    .partners-card {
      background: var(--white); border: 1.5px solid var(--line);
      border-radius: 26px; padding: 30px 22px; text-align: center;
    }
    .partner-chips { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin: 18px 0 22px; }
    .partner-chips span { background: var(--cream); border: 1px solid var(--line); border-radius: 999px; padding: 9px 16px; font-size: 13px; font-weight: 700; }

    /* ═══ НИЖНИЙ ДОК — стекло, как в iOS ═══ */
    .dock {
      position: fixed; z-index: 66; left: 12px; right: 12px; bottom: 10px;
      background: rgba(253,250,243,.78);
      border: 1px solid rgba(255,255,255,.7);
      border-radius: 32px; padding: 10px 22px;
      display: flex; justify-content: space-between; align-items: center;
      backdrop-filter: blur(24px) saturate(1.7);
      -webkit-backdrop-filter: blur(24px) saturate(1.7);
      box-shadow: 0 16px 40px rgba(30,25,15,.22), inset 0 1px 0 rgba(255,255,255,.8);
    }
    .dock a, .dock > button {
      display: grid; justify-items: center; gap: 3px;
      background: none; border: none; padding: 2px 6px;
      font-size: 9.5px; font-weight: 800; color: #A39A85; text-decoration: none;
      transition: transform .15s, color .2s;
    }
    .dock a:active, .dock > button:active { transform: scale(.9); }
    .dock svg.di { width: 26px; height: 26px; display: block; }
    .dock .dock-active { color: var(--green); }
    .dock-search {
      width: 54px; height: 54px; border-radius: 50%;
      background: linear-gradient(180deg, #E0574C 0%, #C6362B 55%, #9E271F 100%);
      color: #fff; border: 1px solid rgba(255,255,255,.55);
      display: grid; place-items: center;
      margin-top: -32px;
      box-shadow: 0 12px 26px rgba(158,39,31,.5), inset 0 2px 3px rgba(255,255,255,.45);
      flex-shrink: 0;
      transition: transform .15s;
    }
    .dock-search:active { transform: scale(.92); }
    .dock-search svg { width: 24px; height: 24px; display: block; }
    .dock-badge {
      position: absolute; top: -7px; right: -11px;
      background: linear-gradient(180deg, #E0574C, #9E271F); color: #fff;
      font-size: 9px; font-weight: 800;
      border-radius: 999px; padding: 1.5px 5px; min-width: 16px; text-align: center;
      border: 1.5px solid rgba(253,250,243,.9);
      box-shadow: 0 3px 8px rgba(158,39,31,.4);
    }
    @keyframes flameFlick {
      0%   { transform: scaleY(1) scaleX(1); }
      35%  { transform: scaleY(1.09) scaleX(.96) rotate(-1.6deg); }
      70%  { transform: scaleY(.94) scaleX(1.05) rotate(1.4deg); }
      100% { transform: scaleY(1.04) scaleX(.98); }
    }
    .flame-outer { transform-origin: 50% 88%; animation: flameFlick 1.1s ease-in-out infinite alternate; }
    .flame-inner { transform-origin: 50% 90%; animation: flameFlick .65s ease-in-out infinite alternate-reverse; }

    /* ═══ ЖИВАЯ КОРЗИНА (нижняя панель) ═══ */
    .cart-bar {
      position: fixed; z-index: 70; left: 12px; right: 12px; bottom: 88px;
      background: var(--green); color: #fff; border-radius: 20px;
      padding: 12px 14px 12px 20px;
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      box-shadow: 0 16px 40px rgba(8,60,86,.4);
      transform: translateY(130%); transition: transform .3s cubic-bezier(.3,1.2,.4,1);
    }
    .cart-bar.show { transform: none; }
    .cart-bar-info small { display: block; font-size: 11.5px; color: rgba(255,252,244,.75); font-weight: 700; }
    .cart-bar-info strong { font-family: 'Prata', serif; font-size: 20px; }
    .cart-bar .btn { min-height: 48px; }

    /* ═══ ШТОРКИ / МОДАЛКИ ═══ */
    .overlay {
      position: fixed; inset: 0; z-index: 80; background: rgba(20,16,10,.55);
      opacity: 0; visibility: hidden; transition: .25s;
    }
    .overlay.show { opacity: 1; visibility: visible; }
    .sheet {
      position: fixed; z-index: 90; left: 0; right: 0; bottom: 0;
      background: var(--cream); border-radius: 32px 32px 0 0;
      box-shadow: 0 -18px 50px rgba(60,40,10,.25);
      max-height: 92svh; overflow-y: auto; -webkit-overflow-scrolling: touch;
      transform: translateY(105%); transition: transform .32s cubic-bezier(.3,1,.4,1);
      padding: 14px 18px calc(24px + env(safe-area-inset-bottom));
    }
    .sheet.show { transform: none; }
    .sheet-grip { width: 44px; height: 5px; border-radius: 99px; background: #D8CFBC; margin: 4px auto 14px; }
    .sheet-close {
      position: absolute; top: 14px; right: 14px; width: 38px; height: 38px;
      border-radius: 50%; border: none; background: #EFE8D8; font-size: 17px; font-weight: 800; color: var(--ink);
    }

    /* карточка товара в модалке */
    .pm-art { position: relative; border-radius: 20px; min-height: 230px; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 26px; margin-bottom: 18px; overflow: hidden; }
    .pm-art::after { content: ""; position: absolute; bottom: 14px; left: 30%; right: 30%; height: 16px; border-radius: 50%; background: rgba(0,0,0,.18); filter: blur(8px); }
    .pm-art .jar { z-index: 2; transition: width .25s, height .25s; }
    .pm-title { font-size: 26px; margin-bottom: 6px; }
    .pm-desc { color: var(--gray); font-size: 15px; margin-bottom: 16px; }
    .size-row { display: flex; gap: 8px; margin-bottom: 14px; }
    .size-btn {
      flex: 1; border: 2px solid var(--line); background: var(--white); border-radius: 14px;
      padding: 10px 6px; display: grid; gap: 2px; text-align: center; transition: .15s;
    }
    .size-btn strong { font-size: 14.5px; }
    .size-btn span { font-size: 12px; color: var(--gray); font-weight: 700; }
    .size-btn.active { border-color: var(--green); background: #FBE7E4; }
    .pm-block { background: var(--white); border: 1px solid var(--line); border-radius: 16px; padding: 14px 16px; margin-bottom: 10px; }
    .pm-block h4 { font-family: 'Manrope', sans-serif; font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--nut); margin-bottom: 6px; }
    .pm-block p { font-size: 14px; color: var(--gray); line-height: 1.6; }
    .pm-price { font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 30px; letter-spacing: -.02em; color: var(--green); margin: 14px 0; }

    /* корзина в шторке */
    .cart-items { display: grid; gap: 10px; margin-bottom: 16px; }
    .cart-row {
      background: var(--white); border: 1px solid var(--line); border-radius: 16px;
      padding: 12px 14px; display: flex; align-items: center; justify-content: space-between; gap: 10px;
    }
    .cart-row-name { font-weight: 800; font-size: 14px; line-height: 1.3; }
    .cart-row-name small { display: block; color: var(--gray); font-weight: 600; font-size: 12px; margin-top: 2px; }
    .qty { display: flex; align-items: center; gap: 2px; flex-shrink: 0; }
    .qty button { width: 36px; height: 36px; border-radius: 10px; border: 1.5px solid var(--line); background: var(--white); font-size: 18px; font-weight: 800; }
    .qty b { min-width: 30px; text-align: center; font-size: 15px; }
    .cart-total-row { display: flex; align-items: center; justify-content: space-between; padding: 14px 4px; border-top: 1.5px solid var(--line); margin-bottom: 12px; }
    .cart-total-row strong { font-family: 'Prata', serif; font-size: 26px; }
    .cart-empty { text-align: center; color: var(--gray); padding: 30px 10px; }

    /* форма заказа */
    .form-grid { display: grid; gap: 10px; margin: 16px 0; }
    .form-grid label { display: grid; gap: 6px; font-size: 13px; font-weight: 800; color: #4A463C; }
    .form-grid input, .form-grid textarea {
      border: 1.5px solid var(--line); border-radius: 14px; background: var(--white);
      padding: 14px 15px; font: inherit; font-size: 16px; outline: none; width: 100%;
    }
    .form-grid input:focus, .form-grid textarea:focus { border-color: var(--green); }
    .order-summary-mini { background: var(--white); border: 1px solid var(--line); border-radius: 16px; padding: 14px 16px; font-size: 14px; display: grid; gap: 6px; }
    .order-summary-mini div { display: flex; justify-content: space-between; gap: 10px; }
    .order-summary-mini .osm-total { font-weight: 800; border-top: 1px solid var(--line); padding-top: 8px; }
    .success-box { text-align: center; padding: 30px 10px 10px; }
    .success-box .emoji { font-size: 54px; display: block; margin-bottom: 14px; }
    .success-box h3 { font-size: 24px; margin-bottom: 10px; }
    .success-box p { color: var(--gray); font-size: 15px; margin-bottom: 22px; }

    .toast {
      position: fixed; z-index: 120; bottom: 92px; left: 50%; transform: translateX(-50%) translateY(16px);
      background: var(--ink); color: #fff; padding: 12px 22px; border-radius: 999px;
      font-size: 14px; font-weight: 700; opacity: 0; transition: .25s; pointer-events: none; white-space: nowrap;
    }
    .toast.show { opacity: 1; transform: translateX(-50%); }

    /* ═══ МЕНЮ / ПОИСК ═══ */
    .header-side { display: flex; align-items: center; gap: 10px; }
    .icon-btn {
      width: 44px; height: 44px; border-radius: 14px;
      border: 1px solid rgba(255,255,255,.8);
      background: rgba(255,255,255,.68); font-size: 18px; display: grid; place-items: center;
      box-shadow: 0 4px 12px rgba(120,90,40,.14), inset 0 1px 0 rgba(255,255,255,.9);
      transition: transform .15s;
    }
    .icon-btn:active { transform: scale(.9); }
    .menu-list { display: grid; gap: 6px; }
    .menu-list a, .menu-list button {
      display: flex; align-items: center; gap: 4px;
      background: var(--white); border: 1.5px solid var(--line); border-radius: 14px;
      padding: 15px 16px; font-size: 16px; font-weight: 800; color: var(--ink);
      text-decoration: none; text-align: left; width: 100%;
    }
    .menu-list a:active, .menu-list button:active { background: #F1EBDD; }
    .search-input {
      width: 100%; border: 2px solid var(--green); border-radius: 14px;
      padding: 14px 16px; font: inherit; font-size: 16px; outline: none; background: var(--white);
      margin-bottom: 12px;
    }
    .search-results { display: grid; gap: 8px; }
    .search-row {
      display: flex; align-items: center; gap: 12px; width: 100%;
      background: var(--white); border: 1.5px solid var(--line); border-radius: 14px;
      padding: 10px 14px; text-align: left;
    }
    .search-row .dot { width: 34px; height: 34px; border-radius: 10px; flex-shrink: 0; }
    .search-row strong { font-size: 15px; display: block; }
    .search-row small { color: var(--gray); font-size: 12.5px; }
    .search-empty { color: var(--gray); text-align: center; padding: 16px 0; font-size: 14px; }

    /* ═══ БЛОКИ КАРТОЧКИ ═══ */
    .compo-list { list-style: none; display: grid; gap: 7px; }
    .compo-list li { display: flex; gap: 9px; font-size: 14px; font-weight: 700; }
    .compo-list li::before { content: "✓"; color: var(--green); font-weight: 800; }
    .review { display: flex; gap: 12px; padding: 12px 0; border-top: 1px solid var(--line); }
    .review:first-of-type { border-top: none; padding-top: 4px; }
    .review-ava {
      width: 42px; height: 42px; border-radius: 50%; flex-shrink: 0;
      background: var(--green); color: var(--cream); display: grid; place-items: center;
      font-weight: 800; font-size: 15px;
    }
    .review-body strong { font-size: 14px; }
    .review-stars { color: var(--gold); font-size: 13px; letter-spacing: 2px; }
    .review-body p { font-size: 13.5px; color: var(--gray); line-height: 1.55; margin-top: 3px; }
    .similar-row { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 6px; }
    .similar-row::-webkit-scrollbar { display: none; }
    .similar-card {
      min-width: 130px; background: var(--white); border: 1.5px solid var(--line); border-radius: 14px;
      padding: 12px; text-align: center;
    }
    .similar-card .dot { width: 40px; height: 40px; border-radius: 12px; margin: 0 auto 8px; }
    .similar-card strong { font-size: 13px; display: block; line-height: 1.25; }
    .similar-card small { color: var(--gray); font-size: 12px; }

    /* ═══ ОПТ ═══ */
    .opt-step {
      font-family: 'Manrope', sans-serif; font-size: 12px; font-weight: 800;
      letter-spacing: .14em; text-transform: uppercase; color: var(--nut);
      margin: 18px 0 10px;
    }
    .opt-flavors { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .opt-fl {
      display: grid; justify-items: center; gap: 6px;
      background: var(--white); border: 2px solid var(--line); border-radius: 16px;
      padding: 12px 6px 10px; font-size: 11px; font-weight: 800; color: var(--ink);
      line-height: 1.25; text-align: center; transition: border-color .15s, background .15s, transform .1s;
    }
    .opt-fl:active { transform: scale(.95); }
    .opt-fl.selected { border-color: var(--green); background: #FBE7E4; }
    .opt-lab { display: grid; gap: 6px; font-size: 13.5px; font-weight: 800; color: #4A463C; margin-bottom: 10px; }
    .opt-lab small { font-weight: 600; color: var(--gray); }
    .opt-lab input {
      border: 2px solid var(--line); border-radius: 14px; background: var(--white);
      padding: 14px 15px; font: inherit; font-size: 17px; font-weight: 700; outline: none;
    }
    .opt-lab input:focus { border-color: var(--green); }
    .opt-note {
      background: #FBEDEB; border: 1.5px solid #F1C7C1; border-radius: 12px;
      padding: 11px 14px; font-size: 13px; color: #9E271F; line-height: 1.55; margin-bottom: 10px;
    }

    /* ═══ УСПЕХ ═══ */
    .check-circle {
      width: 92px; height: 92px; border-radius: 50%; margin: 0 auto 18px;
      background: #2E7D46; color: #fff; display: grid; place-items: center;
      font-size: 48px; box-shadow: 0 14px 36px rgba(46,125,70,.4);
    }
    .delivery-line { color: var(--gray); font-size: 13px; }

    /* ═══ ФУТЕР ═══ */
    footer { border-top: 1px solid var(--line); padding: 40px 20px 150px; text-align: center; }
    footer .logo { justify-content: center; margin-bottom: 12px; }
    footer p { color: var(--gray); font-size: 13.5px; margin-bottom: 6px; }
    .footer-wa {
      display: inline-flex; align-items: center; gap: 8px; margin: 14px 0;
      background: linear-gradient(180deg,#E0574C,#C6362B); color: #fff; text-decoration: none; font-weight: 800; font-size: 15px;
      padding: 13px 26px; border-radius: 999px; box-shadow: 0 8px 20px rgba(198,54,43,.35);
    }

    /* ═══ ПЛАНШЕТ / ДЕСКТОП ═══ */
    @media (min-width: 720px) {
      .hero-btns { flex-direction: row; max-width: none; justify-content: center; }
      .hero-btns .btn { min-width: 220px; }
      .trust-strip { grid-template-columns: repeat(4, 1fr); }
      .catalog-grid { grid-template-columns: repeat(3, 1fr); gap: 16px; }
      .collections { grid-template-columns: 1fr 1fr; }
      .intro-card { display: grid; grid-template-columns: 1fr 1fr; }
      .intro-box { min-height: 100%; }
      .two-btns { grid-template-columns: 1fr 1fr; }
      .sheet { left: 50%; right: auto; width: 520px; transform: translateX(-50%) translateY(105%); border-radius: 26px; bottom: 20px; }
      .sheet.show { transform: translateX(-50%); }
      .cart-bar { left: 50%; right: auto; transform: translateX(-50%) translateY(300%); width: 520px; }
      .cart-bar.show { transform: translateX(-50%); }
      .dock { left: 50%; right: auto; transform: translateX(-50%); width: 520px; }
    }
    @media (min-width: 1000px) {
      .catalog-grid { grid-template-columns: repeat(4, 1fr); }
    }

    /* ═══ КИКЕР НА ЭКРАНЕ-ПРИВЕТСТВИИ ═══ */
    .hero-kicker { display:inline-block; background:rgba(255,255,255,.16); border:1px solid rgba(255,255,255,.4); -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px); color:#FFFDF6; font-size:11.5px; font-weight:800; letter-spacing:.13em; text-transform:uppercase; padding:7px 14px; border-radius:999px; margin-bottom:14px; text-shadow:0 1px 6px rgba(0,0,0,.4); }

    /* ═══ НАША ИСТОРИЯ / О НАС ═══ */
    .story-grid { display:grid; gap:14px; margin-top:24px; }
    .story-card { background:var(--white); border:1.5px solid var(--line); border-radius:22px; padding:22px 20px; box-shadow:0 10px 30px rgba(60,45,20,.06); }
    .story-card .ic { font-size:30px; display:block; margin-bottom:10px; }
    .story-card h3 { font-family:'Manrope',sans-serif; font-weight:800; font-size:17px; margin-bottom:6px; }
    .story-card p { color:var(--gray); font-size:14.5px; line-height:1.6; }
    .whatis { background:var(--white); border:1.5px solid var(--line); border-radius:22px; padding:24px 22px; margin-top:16px; }
    .whatis h3 { font-size:22px; margin-bottom:10px; }
    .whatis p { color:var(--gray); font-size:15px; line-height:1.7; }
    .about-band { background:linear-gradient(160deg,#10618C,#0B3A54); color:#FBF6EC; border-radius:26px; padding:32px 24px; margin-top:16px; box-shadow:0 18px 44px rgba(11,58,84,.3); }
    .about-band .eyebrow { color:#8FD0EE; }
    .about-band h3 { font-family:'Prata',serif; font-size:clamp(22px,5vw,30px); margin-bottom:14px; color:#fff; }
    .about-band p { color:rgba(251,246,236,.92); font-size:15px; line-height:1.7; margin-bottom:12px; }
    .about-sign { display:flex; align-items:center; gap:12px; margin-top:18px; }
    .about-sign .ava { width:46px; height:46px; border-radius:50%; background:var(--gold); color:#fff; display:grid; place-items:center; font-weight:800; font-size:18px; flex-shrink:0; }
    .about-sign strong { display:block; font-size:15px; color:#fff; }
    .about-sign small { color:rgba(251,246,236,.72); font-size:13px; }
    @media (min-width:720px){ .story-grid { grid-template-columns:repeat(3,1fr); } }
    /* ═══ ЭКРАНЫ (навигация по иконкам) ═══ */
    .screen { display:none; }
    .screen.active { display:block; animation:screenIn .28s ease both; }
    @keyframes screenIn { from{opacity:0; transform:translateY(8px);} to{opacity:1; transform:none;} }
    /* ═══ ОПТ-СТРАНИЦА ═══ */
    .opt-page { padding-top: 20px; }
    .opt-back { background:none; border:none; color:var(--green); font-weight:800; font-size:14px; padding:6px 0; margin-bottom:8px; display:inline-flex; align-items:center; gap:6px; text-decoration:none; cursor:pointer; }
    .opt-card { background:var(--white); border:1.5px solid var(--line); border-radius:22px; padding:18px 18px 20px; margin-bottom:14px; box-shadow:0 10px 26px rgba(110,80,30,.08); }
    .opt-card .opt-step { margin-top:0; }
    /* ═══ ДИЗАЙН-АПГРЕЙД 2026 ═══ */
    body { letter-spacing:.002em; }
    .section { padding:56px 18px; }
    .eyebrow { letter-spacing:.24em; }
    .sec-title { letter-spacing:-.01em; }
    .sec-lead { font-size:16px; }
    .hero { min-height:86svh; }
    .hero-shade { background:linear-gradient(to bottom, rgba(18,12,6,0) 22%, rgba(18,12,6,.30) 52%, rgba(18,12,6,.86) 100%); }
    .hero-title { letter-spacing:-.015em; }
    .hero-kicker { background:rgba(198,54,43,.92); border-color:rgba(255,255,255,.35); color:#fff; }
    .trust-strip { background:var(--white); border-top:1px solid var(--line); }
    .trust-strip div { background:var(--white); padding:20px 12px; }
    .trust-strip strong { font-family:'Manrope',sans-serif; font-weight:800; color:var(--green); letter-spacing:-.02em; font-size:24px; }
    .trust-strip span { font-size:12px; }
    .pcard { border:1px solid var(--line); border-radius:24px; box-shadow:0 6px 18px rgba(60,45,20,.08); transition:transform .22s cubic-bezier(.2,.7,.2,1), box-shadow .22s, border-color .22s; }
    .pcard:hover { transform:translateY(-5px); box-shadow:0 20px 44px rgba(60,45,20,.16); border-color:rgba(198,54,43,.28); }
    .pcard-art { min-height:200px; background:radial-gradient(120% 90% at 50% 12%, rgba(255,255,255,.55), transparent 72%); }
    .pcard-body { padding:16px 16px 18px; }
    .pcard-price { font-size:21px; }
    .pcard-badge { box-shadow:0 6px 16px rgba(198,54,43,.32); }
    .btn-green { box-shadow:0 8px 20px rgba(198,54,43,.26), inset 0 1px 0 rgba(255,255,255,.25); }
    .btn-gold { box-shadow:0 8px 20px rgba(198,54,43,.4); }
    html.js [data-screen-view="home"] .reveal { opacity:0; transform:translateY(22px); }
    html.js [data-screen-view="home"] .reveal.in { opacity:1; transform:none; transition:opacity .7s ease, transform .7s cubic-bezier(.2,.7,.2,1); }
    /* ═══ ТИПОГРАФИКА: жирнее и читаемее ═══ */
    .sec-lead { font-weight:500; color:#453F35; }
    .pcard-desc { font-weight:500; color:#57534A; }
    .pcard-body h3 { font-size:17px; font-weight:800; letter-spacing:-.01em; }
    .intro-info > p, .col-flavors, .pm-desc { font-weight:500; color:#453F35; }
    .compo-list li { font-weight:700; }
    .hero-sub { font-weight:600; }
    .intro-info h3, .col-info h3 { letter-spacing:-.01em; }

    /* ═══ БОЛЬШАЯ КАРТОЧКА «О НАС» ═══ */
    .about-cta { display:block; position:relative; overflow:hidden; border-radius:26px; min-height:250px; text-decoration:none; box-shadow:0 18px 44px rgba(60,45,20,.2); margin-top:6px; }
    .about-cta .bg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:1; }
    .about-cta::before { content:""; position:absolute; inset:0; background:linear-gradient(160deg,#3E2A18,#1E1108); z-index:0; }
    .about-cta::after { content:""; position:absolute; inset:0; background:linear-gradient(to top, rgba(26,15,7,.92) 8%, rgba(26,15,7,.5) 55%, rgba(26,15,7,.2)); z-index:2; }
    .about-cta-in { position:relative; z-index:3; min-height:250px; padding:26px 22px 24px; display:flex; flex-direction:column; align-items:flex-start; justify-content:flex-end; }
    .about-cta .eyebrow { color:#E9938A; margin-bottom:8px; }
    .about-cta h3 { color:#fff; font-family:'Prata',serif; font-weight:400; font-size:clamp(23px,6vw,32px); line-height:1.14; margin-bottom:8px; max-width:540px; text-shadow:0 3px 18px rgba(0,0,0,.4); }
    .about-cta p { color:rgba(255,252,244,.92); font-size:15px; font-weight:500; margin-bottom:16px; max-width:470px; }
    .about-cta-btn { display:inline-flex; align-items:center; gap:8px; background:linear-gradient(180deg,#E9938A,#C6362B); color:#fff; font-weight:800; font-size:14.5px; padding:13px 22px; border-radius:999px; box-shadow:0 8px 20px rgba(198,54,43,.4); }
    .about-cta:active { transform:scale(.995); }
    /* ═══ КРАСИВЫЙ ШРИФТ ВЕЗДЕ (Unbounded) ═══ */
    .logo strong { font-family:'Unbounded','Manrope',sans-serif; font-weight:800; letter-spacing:.01em; }
    .hero-title { font-family:'Unbounded','Manrope',sans-serif; font-weight:800; letter-spacing:-.02em; }
    .sec-title { font-family:'Unbounded','Manrope',sans-serif; font-weight:700; letter-spacing:-.025em; }
    .pcard-body h3, .intro-info h3, .col-info h3, .pm-title { font-family:'Unbounded','Manrope',sans-serif; font-weight:600; letter-spacing:-.02em; }
    .pcard-price, .price-now, .pm-price, .cart-total-row strong { font-family:'Unbounded','Manrope',sans-serif; font-weight:700; letter-spacing:-.03em; }
    .eyebrow { font-family:'Unbounded','Manrope',sans-serif; font-weight:700; letter-spacing:.12em; color:var(--green); }
    .btn { font-family:'Unbounded','Manrope',sans-serif; font-weight:700; letter-spacing:-.01em; }

    /* ═══ БОЛЬШАЯ ПЕРЕКРАШЕННАЯ КАРТОЧКА «О НАС» ═══ */
    .about-cta { min-height:300px; }
    .about-cta-in { min-height:300px; }
    .about-cta::before { background:linear-gradient(160deg,#6A3A1E,#2A1206); }
    .about-cta::after { background:linear-gradient(to top, rgba(30,12,4,.92) 8%, rgba(30,12,4,.5) 58%, rgba(30,12,4,.15)); }
    .about-cta h3 { font-family:'Unbounded','Manrope',sans-serif; font-weight:700; font-size:clamp(24px,6.4vw,34px); }
    .about-cta .eyebrow { color:var(--gold-soft, #E9938A); }
    /* ═══ УПРОЩЕНИЕ + ЖЁЛТЫЙ + МЕЛКИЕ КАРТОЧКИ ═══ */
    :root{ --yellow:#F2C14E; }
    .strip{ background:#181410; overflow:hidden; padding:11px 12px; }
    .strip span{ display:block; text-align:center; color:var(--yellow); font-family:'Unbounded','Manrope',sans-serif; font-weight:700; font-size:10.5px; letter-spacing:.16em; }
    .catalog-grid{ grid-template-columns:1fr 1fr; gap:10px; }
    @media (max-width:380px){ .catalog-grid{ grid-template-columns:1fr 1fr; } }
    .catalog-grid .pcard-art{ min-height:116px; padding-bottom:10px; }
    .catalog-grid .pcard-art .jar{ width:56px; height:78px; }
    .catalog-grid .pcard-body{ padding:10px 11px 12px; }
    .catalog-grid .pcard-desc, .catalog-grid .pcard-sizes{ display:none; }
    .catalog-grid .pcard-body h3{ font-size:13.5px; margin-bottom:4px; }
    .catalog-grid .pcard-price{ font-size:16px; margin-bottom:8px; }
    .catalog-grid .pcard-actions .btn{ min-height:36px; font-size:12px; padding:7px 10px; }
    .pcard-body h3{ font-family:'Unbounded','Manrope',sans-serif; font-weight:700; letter-spacing:-.02em; }
    .pcard-price{ font-family:'Unbounded','Manrope',sans-serif; }
    .sets-fab{ position:fixed; right:12px; bottom:112px; z-index:65; display:flex; align-items:center; gap:7px; background:#181410; color:var(--yellow); text-decoration:none; font:800 12.5px 'Unbounded','Manrope',sans-serif; padding:10px 14px; border-radius:999px; box-shadow:0 10px 24px rgba(0,0,0,.32); }
    .sets-fab .fic{ font-size:15px; }
    @media (min-width:560px){ .sets-fab{ right:calc(50% - 240px); } }
    .dock{ background:rgba(253,250,243,.97); box-shadow:0 -6px 24px rgba(30,20,10,.16); }
    /* ═══ ПРАВКИ: fab, коллекции, размеры ═══ */
    .sets-fab{ background:linear-gradient(180deg,#E0574C,#C6362B); color:#fff; }
    .col-badge{ display:none !important; }
    .catalog-grid .pcard-art{ min-height:104px; }
    .catalog-grid .pcard-art .jar{ width:50px; height:70px; }
    .dock svg.di{ width:24px; height:24px; }
    .dock a, .dock > button{ font-size:9px; }
    /* ═══ ЗАМЕТНЫЙ НИЖНИЙ ДОК + ЯРКАЯ КНОПКА ═══ */
    .dock{ background:linear-gradient(180deg,#FFFDF7,#F2EBDB); border-top:2px solid rgba(198,54,43,.55); box-shadow:0 -8px 26px rgba(30,20,10,.18); }
    .dock a, .dock > button{ position:relative; }
    .dock .dock-active{ color:var(--green); }
    .dock .dock-active::before{ content:""; position:absolute; top:1px; left:50%; transform:translateX(-50%); width:22px; height:3px; border-radius:3px; background:var(--green); }
    .allflav{ width:100%; min-height:54px; border-radius:16px; color:#fff; font-weight:800; font-size:16px;
      background:linear-gradient(180deg,#E0574C,#C6362B); box-shadow:0 12px 26px rgba(198,54,43,.34); }
    .allflav:hover{ filter:brightness(1.05); }
    /* ═══ ЭКРАН О НАС (синий) ═══ */
    [data-screen-view="story"]{ background:#EEF3F8; }
    .story-hero{ position:relative; height:50vh; min-height:330px; display:flex; align-items:flex-end; overflow:hidden; }
    .story-hero img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
    .story-hero .bg2{ position:absolute; inset:0; background:linear-gradient(160deg,#3E86C4,#0C2340); }
    .story-hero .sh{ position:absolute; inset:0; background:linear-gradient(to top, rgba(8,20,38,.92), rgba(8,20,38,.15)); }
    .story-hero-in{ position:relative; z-index:2; padding:0 20px 26px; }
    .story-hero-in span{ color:#8FC0EA; font-size:12px; font-weight:800; letter-spacing:.2em; text-transform:uppercase; }
    .story-hero-in h2{ color:#fff; font-family:'Unbounded','Manrope',sans-serif; font-weight:700; font-size:clamp(26px,7vw,36px); margin:8px 0; }
    .story-hero-in p{ color:rgba(255,255,255,.92); font-size:15px; font-weight:500; max-width:320px; }
    .story-body{ padding:26px 16px 40px; }
    .story-lead{ font-size:17px; font-weight:600; color:#213445; line-height:1.6; margin-bottom:20px; }
    .story-cards{ display:grid; gap:12px; margin-bottom:22px; }
    .story-cards .c{ background:#fff; border:1px solid #DEE7EF; border-radius:18px; padding:18px; box-shadow:0 8px 22px rgba(20,50,90,.06); }
    .story-cards .c .i{ font-size:26px; }
    .story-cards .c h4{ font-family:'Unbounded','Manrope',sans-serif; font-weight:700; font-size:17px; color:#173A5A; margin:8px 0 4px; }
    .story-cards .c p{ color:#54606C; font-size:14px; font-weight:500; line-height:1.55; }
    .story-final{ font-family:'Unbounded','Manrope',sans-serif; font-weight:700; font-size:clamp(22px,6vw,30px); color:#12335A; text-align:center; margin:8px 0 22px; line-height:1.2; }
    .btn-blue{ background:linear-gradient(180deg,#E0574C,#C6362B); color:#fff; min-height:54px; border-radius:16px; font-weight:800; box-shadow:0 12px 26px rgba(198,54,43,.32); }
    /* ═══ КАРТОЧКИ КАТАЛОГА ЧУТЬ КРУПНЕЕ ═══ */
    .catalog-grid{ gap:12px; }
    .catalog-grid .pcard-art{ min-height:146px; }
    .catalog-grid .pcard-art .jar{ width:68px; height:92px; }
    .catalog-grid .pcard-body h3{ font-size:14.5px; }
    .catalog-grid .pcard-price{ font-size:17px; }
    .catalog-grid .pcard-actions .btn{ min-height:38px; font-size:12.5px; }
    /* «16 вкусов» крупнее */
    #catalog .sec-head .eyebrow{ font-size:13.5px; letter-spacing:.14em; }
    .grid-sub{ grid-column:1/-1; font:800 14.5px 'Unbounded','Manrope',sans-serif; letter-spacing:.02em; color:#17140F; text-transform:uppercase; padding:18px 2px 4px; }
    .pcard-photo{ position:absolute; inset:0; width:100%; height:100%; object-fit:contain; background:#fff; z-index:4; }
    .pcard-badge{ z-index:6; }
    .catalog-grid .pcard-art{ min-height:196px; }
    .hits-scroll .pcard .pcard-art{ min-height:196px; }
    .pm-art{ min-height:300px; }
    .pm-photo{ position:absolute; inset:0; width:100%; height:100%; object-fit:contain; background:#fff; border-radius:20px; z-index:4; }
  </style>
</head>
