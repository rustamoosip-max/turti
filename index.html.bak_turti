      "flax-black":   { name: "Чёрный лён",             color: "#33302A", group: "seed", ing: "чёрный лён",     plus: "🧠 Омега-3 · 💪 Клетчатка · ❤️ Для сосудов", desc: "Классика здоровья: омега-3 и лёгкая приятная горчинка.", eat: "В кашу, в смузи, с мёдом на хлеб.", prices: { 250: 349, 450: 590, 1000: 1190 } },
      "flax-seeds":   { name: "Чёрный лён с семечками", color: "#4A4136", group: "seed", ing: "лён и семечки",  plus: "🧠 Омега-3 · 🌻 Витамин E · 💪 Сытость", desc: "Лён и подсолнечные семечки — мягче, сытнее, вкуснее.", eat: "На завтрак с тостами, в творог.", prices: { 250: 379, 450: 650, 1000: 1290 } },
      "flax-white":   { name: "Белый лён",              color: "#E2D3B3", group: "seed", ing: "белый лён",      plus: "🌿 Мягкий вкус · 🧠 Омега-3 · 🍃 Лёгкость", desc: "Нежнее чёрного льна. Мягкий вкус для лёгкого старта.", eat: "В йогурт, кашу, смузи.", prices: { 250: 349, 450: 590, 1000: 1190 } },
      "flax-mix":     { name: "Ассорти со льном",       color: "#7A6B4F", group: "seed", ing: "лён и орехи",    plus: "🧠 Омега-3 · 🥜 Белок · ⚡ Энергия", desc: "Лён с орехами: польза семян и вкус орехов в одной банке.", eat: "С хлебом, фруктами, в выпечку.", prices: { 250: 399, 450: 690, 1000: 1390 } },
      "peanut":       { name: "Арахисовый",             color: "#B87A3D", group: "nut",  ing: "арахис",         plus: "🥜 26 г белка · ⚡ Энергия · 💪 Для спорта", desc: "Насыщенный вкус обжаренного арахиса. Много белка.", eat: "С тостами, бананом, в кашу и смузи.", prices: { 250: 379, 450: 690, 1000: 1390 }, hit: true },
      "pistachio":    { name: "Фисташковый",            color: "#6B8C5C", group: "nut",  ing: "фисташка",       plus: "💎 Премиум · 👁 Лютеин · ❤️ Для сердца", desc: "Премиальный и редкий. Ярко-фисташковый вкус.", eat: "С круассаном, в десерты, просто ложкой.", prices: { 250: 1490, 450: 2590, 1000: 5490 }, hit: true, badge: "Премиум" },
      "almond":       { name: "Миндальный",             color: "#DDB97C", group: "nut",  ing: "миндаль",        plus: "✨ Витамин E · 🧘 Магний · ❤️ Полезные жиры", desc: "Мягкий, кремовый, самый популярный вкус.", eat: "С тостами, в кашу, в кофе.", prices: { 250: 449, 450: 790, 1000: 1590 }, hit: true, badge: "Хит №1" },
      "cashew":       { name: "Кешью",                  color: "#C9A96E", group: "nut",  ing: "кешью",          plus: "🍼 Нежность · 🩸 Железо · 🛡 Цинк", desc: "Самый нежный. Нравится даже детям.", eat: "С фруктами, блинами, в десерты.", prices: { 250: 699, 450: 1199, 1000: 2390 }, hit: true },
      "almond-cashew":{ name: "Миндаль с кешью",        color: "#D4B084", group: "nut",  ing: "миндаль и кешью",plus: "✨ Витамин E · 🍼 Нежность · 🧘 Магний", desc: "Два самых нежных ореха в одной банке.", eat: "С тостами, сырниками, фруктами.", prices: { 250: 549, 450: 950, 1000: 1890 } },
      "three-nuts":   { name: "Ассорти три ореха",      color: "#A9885C", group: "nut",  ing: "миндаль, кешью, арахис", plus: "🥜 Три ореха · ⚡ Энергия · 💪 Белок", desc: "Миндаль, кешью и арахис — богатый ореховый вкус.", eat: "На хлеб, в кашу, к сырам.", prices: { 250: 549, 450: 950, 1000: 1890 } },
      "hazelnut":     { name: "Фундук",                 color: "#8A5A2B", group: "nut",  ing: "фундук",         plus: "🌰 Глубокий вкус · ❤️ Для сердца · ✨ Витамин E", desc: "Глубокий вкус лесного ореха без единой добавки.", eat: "С блинами, кофе, в десерты.", prices: { 250: 749, 450: 1290, 1000: 2590 } },
      "hazelnut-cocoa":{ name: "Фундук Какао-бобы",     color: "#4A2810", group: "nut",  ing: "фундук и какао-бобы", plus: "😊 Серотонин · 🍫 Настоящий какао · 🌿 Без добавок", desc: "Честная альтернатива нутелле. Только фундук и какао.", eat: "На хлеб, с блинами, в горячее молоко.", prices: { 250: 799, 450: 1390, 1000: 2790 }, hit: true, badge: "Хит продаж" },
      "walnut":       { name: "Грецкий орех",           color: "#8B7355", group: "nut",  ing: "грецкий орех",   plus: "🧠 Для ума · 🧠 Омега-3 · ⚡ Энергия", desc: "Богат омега-3. Для ума, сердца и энергии.", eat: "С мёдом, в кашу, к сырам.", prices: { 250: 629, 450: 1090, 1000: 2190 } },
      "sesame":       { name: "Кунжут",                 color: "#E8DCC0", group: "seed", ing: "кунжут",         plus: "🦴 Кальций · 🩸 Железо · 🌿 Тахини-текстура", desc: "Природный кальций и нежная тахини-текстура.", eat: "В соусы, хумус, выпечку, с мёдом.", prices: { 250: 399, 450: 690, 1000: 1390 } },
      "hemp":         { name: "Конопля",                color: "#5F7048", group: "seed", ing: "семена конопли", plus: "💪 Растительный белок · 🧠 Омега-3 · ⚡ Энергия", desc: "Растительный белок и мягкий ореховый вкус.", eat: "В смузи, кашу, спортивное питание.", prices: { 250: 449, 450: 790, 1000: 1590 } },
      "thistle":      { name: "Расторопша",             color: "#9C9A6E", group: "seed", ing: "расторопша",     plus: "🌿 Для печени · 🛡 Силимарин · 🍃 Природная сила", desc: "Природная поддержка печени. Сила трав Кавказа.", eat: "По ложке утром, в смузи, с мёдом.", prices: { 250: 349, 450: 590, 1000: 1190 } }
    };

    const REVIEWS = {
      nut: [
        { n: "Мадина", t: "Заказываю уже третий раз. Вкус как в детстве у бабушки. Ребёнок ест с удовольствием!", s: 5 },
        { n: "Артём", t: "Настоящий состав — один ингредиент. Проверил лично. Беру килограммовую банку.", s: 5 }
      ],
      seed: [
        { n: "Ольга", t: "Добавляю в кашу каждое утро. Состав чистый, без добавок — то, что искала.", s: 5 },
        { n: "Руслан", t: "Качество отличное, доставка быстрая. Видно, что делают на совесть.", s: 5 }
      ]
    };

    const HITS = ["hazelnut-cocoa", "pistachio", "cashew", "peanut", "almond"];

    const COLLECTIONS = {
      "col-intro":  { name: "Первое знакомство", items: ["almond","peanut","hazelnut-cocoa"], price: 1490 },
      "col-fav":    { name: "Любимые вкусы",     items: ["almond","pistachio","cashew"], price: 2390 },
      "col-nuts":   { name: "Ореховая коллекция",items: ["almond","peanut","cashew","three-nuts"], price: 1890 },
      "col-nature": { name: "Сила природы",      items: ["flax-black","flax-white","sesame","hemp","thistle"], price: 1690 },
      "col-full":   { name: "Коллекция URBAWILD",items: ["hazelnut-cocoa","almond","pistachio","cashew","peanut"], price: 3490 }
    };
    Object.values(COLLECTIONS).forEach(c => {
      c.oldPrice = c.items.reduce((s, id) => s + PRODUCTS[id].prices[250], 0);
      c.save = c.oldPrice - c.price;
    });

    /* ═══════════ ХЕЛПЕРЫ ═══════════ */
    const $ = s => document.querySelector(s);
    const $$ = s => document.querySelectorAll(s);

    function jarHTML(id, opts = {}) {
      const p = PRODUCTS[id];
      const w = opts.w || 74, h = opts.h || 100;
      return `<div class="jar" style="background:${p.color};width:${w}px;height:${h}px">
        <div class="jar-lid"></div>
        <div class="jar-body"><div class="jar-tag"><span>URBAWILD</span><strong>${p.name.toUpperCase()}</strong></div></div>
      </div>`;
    }

    function toast(msg) {
      const t = $("#toast");
      t.textContent = msg;
      t.classList.add("show");
      clearTimeout(toast.timer);
      toast.timer = setTimeout(() => t.classList.remove("show"), 1700);
    }

    /* ═══════════ КОРЗИНА (localStorage — заказ не теряется) ═══════════ */
    function getCart() { try { return JSON.parse(localStorage.getItem(CART_KEY)) || {}; } catch (e) { return {}; } }
    function saveCart(c) { localStorage.setItem(CART_KEY, JSON.stringify(c)); refreshCartUI(); }

    function itemInfo(key) {
      if (key.startsWith("col-")) {
        const c = COLLECTIONS[key];
        return c ? { label: "Набор «" + c.name + "»", sub: c.items.length + " банок × 250 г", price: c.price } : null;
      }
      const [id, size] = key.split("|");
      const p = PRODUCTS[id];
      return p ? { label: p.name, sub: size + " г", price: p.prices[size] } : null;
    }

    function addToCart(key, qty = 1) {
      const cart = getCart();
      cart[key] = (cart[key] || 0) + qty;
      saveCart(cart);
      toast("Добавлено в корзину ✓");
    }
    function setQty(key, qty) {
      const cart = getCart();
      if (qty <= 0) delete cart[key]; else cart[key] = qty;
      saveCart(cart);
    }
    function cartLines() {
      const cart = getCart();
      return Object.keys(cart).map(key => {
        const info = itemInfo(key);
        return info ? { key, qty: cart[key], ...info, sum: info.price * cart[key] } : null;
      }).filter(Boolean);
    }
    function cartTotal() { return cartLines().reduce((s, l) => s + l.sum, 0); }
    function cartCount() { return cartLines().reduce((s, l) => s + l.qty, 0); }

    function refreshCartUI() {
      const n = cartCount(), total = cartTotal();
      $$(".cart-count").forEach(el => el.textContent = n);
      if ($("#cart-sheet").classList.contains("show")) renderCartSheet();
    }
    function plural(n, a, b, c) {
      const m10 = n % 10, m100 = n % 100;
      if (m10 === 1 && m100 !== 11) return a;
      if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return b;
      return c;
    }

    /* ═══ ШТОРКИ ═══ */
    let sheetOpen = false;
    function openSheet(id) {
      closeSheets(true);
      $("#overlay").classList.add("show");
      $("#" + id).classList.add("show");
      document.body.classList.add("locked");
      sheetOpen = true;
    }
    function closeSheets(keepOverlay) {
      $$(".sheet").forEach(s => s.classList.remove("show"));
      if (!keepOverlay) {
        $("#overlay").classList.remove("show");
        document.body.classList.remove("locked");
        sheetOpen = false;
        refreshCartUI();
      }
    }
    $("#overlay").addEventListener("click", () => closeSheets());
    document.addEventListener("keydown", e => { if (e.key === "Escape") closeSheets(); });

    /* ═══ РЕНДЕР КАРТОЧЕК ═══ */
    const PHOTOS = {
      "almond": { 250:"images/almond-250.png", 450:"images/almond-450.png", 1000:"images/almond-1000.png" }
    };
    function productCard(id, badge) {
      const p = PRODUCTS[id];
      const b = badge || p.badge;
      return `<article class="pcard" data-open-product="${id}">
        <div class="pcard-art" style="background:linear-gradient(155deg, ${p.color}3D, ${p.color}12)">
          ${b ? `<span class="pcard-badge">${b}</span>` : ""}
          ${PHOTOS[id] ? `<img class="pcard-photo" src="${PHOTOS[id][250]}" alt="${p.name}" onerror="this.style.display='none'">` : ""}
          ${jarHTML(id)}
        </div>
        <div class="pcard-body">
          <h3>${p.name}</h3>
          <p class="pcard-desc">${p.desc}</p>
          <div class="pcard-sizes"><span>250 г</span><span>450 г</span><span>1 кг</span></div>
          <div class="pcard-price">от ${money(p.prices[250])} <small>за 250 г</small></div>
          <div class="pcard-actions">
            <button class="btn btn-green btn-sm" data-open-product="${id}">Купить</button>
            <button class="btn btn-outline btn-sm" data-open-product="${id}">Подробнее</button>
          </div>
        </div>
      </article>`;
    }

    $("#hits-list").innerHTML = HITS.map(id => productCard(id)).join("");
    const CAT_NUTS = ["hazelnut-cocoa","pistachio","almond","cashew","peanut","hazelnut","walnut","almond-cashew","three-nuts"];
    const CAT_SEEDS = ["sesame","hemp","flax-black","flax-white","flax-seeds","flax-mix","thistle"];
    $("#catalog-list").innerHTML =
      CAT_NUTS.map(id => productCard(id)).join("") +
      `<div class="grid-sub">Дары природы · семена и суперфуды</div>` +
      CAT_SEEDS.map(id => productCard(id)).join("");

    $("#collections-list").innerHTML = Object.entries(COLLECTIONS).map(([cid, c]) => `
      <article class="col-card">
        <div class="col-box">
          <span class="col-badge">выгода ${c.save} ₽</span>
          ${c.items.map(id => jarHTML(id, { w: 56, h: 78 })).join("")}
        </div>
        <div class="col-info">
          <h3>«${c.name}»</h3>
          <p class="col-flavors">${c.items.map(id => PRODUCTS[id].name).join(" · ")} — по 250 г, в фирменной коробке URBAWILD.</p>
          <div class="col-foot">
            <div><span class="price-now" style="font-size:24px">${money(c.price)}</span>
            <span class="price-old" style="margin-left:8px">${money(c.oldPrice)}</span></div>
          </div>
          <div class="two-btns">
            <button class="btn btn-green" data-buy-now="${cid}">Купить сейчас</button>
            <button class="btn btn-outline" data-add="${cid}">Добавить в корзину</button>
          </div>
        </div>
      </article>`).join("");

    /* ═══ КАРТОЧКА ТОВАРА ═══ */
    let pmSize = 250;
    function openProduct(id) {
      const p = PRODUCTS[id];
      const ph = PHOTOS[id];
      pmSize = 250;
      const jarSizes = { 250: [96, 130], 450: [110, 152], 1000: [128, 180] };
      const similar = Object.keys(PRODUCTS).filter(x => x !== id && PRODUCTS[x].group === p.group).slice(0, 3);
      const reviews = REVIEWS[p.group] || [];
      $("#product-sheet").innerHTML = `
        <div class="sheet-grip"></div>
        <button class="sheet-close" data-close>✕</button>
        <div class="pm-art" style="background:${p.color}26">${ph ? `<img id="pm-photo" class="pm-photo" src="${ph[250]}" alt="${p.name}" onerror="this.style.display='none'">` : ""}${jarHTML(id, { w: 96, h: 130 })}</div>
        <h3 class="pm-title">${p.name}</h3>
        <p class="pm-desc">${p.desc}</p>
        <div class="size-row" id="pm-sizes">
          ${[250, 450, 1000].map(s => `
            <button class="size-btn ${s === 250 ? "active" : ""}" data-size="${s}">
              <strong>${s === 1000 ? "1 кг" : s + " г"}</strong><span>${money(p.prices[s])}</span>
            </button>`).join("")}
        </div>
        <div class="pm-price" id="pm-price">${money(p.prices[250])}</div>
        <div class="two-btns" style="margin-bottom:14px">
          <button class="btn btn-green" id="pm-buy">Купить сейчас</button>
          <button class="btn btn-outline" id="pm-add">Добавить в корзину</button>
        </div>
        <div class="pm-block"><h4>Польза</h4><p style="font-weight:700;color:var(--ink)">${p.plus}</p></div>
        <div class="pm-block"><h4>Состав</h4>
          <ul class="compo-list">
            <li>100% ${p.ing}</li>
            <li>Без добавок</li>
            <li>Без консервантов</li>
          </ul>
        </div>
        <div class="pm-block"><h4>Похожие вкусы</h4>
          <div class="similar-row">
            ${similar.map(sid => `
              <button class="similar-card" data-open-product="${sid}">
                <span class="dot" style="display:block;background:${PRODUCTS[sid].color}"></span>
                <strong>${PRODUCTS[sid].name}</strong>
                <small>от ${money(PRODUCTS[sid].prices[250])}</small>
              </button>`).join("")}
          </div>
        </div>`;
      openSheet("product-sheet");

      const jarEl = $("#product-sheet .pm-art .jar");
      $("#pm-sizes").addEventListener("click", e => {
        const btn = e.target.closest(".size-btn");
        if (!btn) return;
        $$("#pm-sizes .size-btn").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        pmSize = +btn.dataset.size;
        $("#pm-price").textContent = money(p.prices[pmSize]);
        if (ph) { const im = $("#pm-photo"); if (im) { im.src = ph[pmSize]; im.style.display = ""; } }
        else if (jarEl) { const [w, h] = jarSizes[pmSize]; jarEl.style.width = w + "px"; jarEl.style.height = h + "px"; }
      });
      const doAdd = () => { addToCart(id + "|" + pmSize); closeSheets(); };
      const doBuy = () => openCheckout([{ key: id + "|" + pmSize, qty: 1 }], "buynow");
      $("#pm-add").addEventListener("click", doAdd);
      $("#pm-buy").addEventListener("click", doBuy);
    }

    /* ═══ КОРЗИНА (шторка) ═══ */
    function renderCartSheet() {
      const lines = cartLines();
      $("#cart-sheet").innerHTML = `
        <div class="sheet-grip"></div>
        <button class="sheet-close" data-close>✕</button>
        <h3 style="font-size:24px;margin-bottom:14px">Корзина</h3>
        ${lines.length ? `
          <div class="cart-items">
            ${lines.map(l => `
              <div class="cart-row">
                <div class="cart-row-name">${l.label}<small>${l.sub} · ${money(l.price)}</small></div>
                <div class="qty">
                  <button data-qty="${l.key}|-1">−</button>
                  <b>${l.qty}</b>
                  <button data-qty="${l.key}|1">+</button>
                </div>
              </div>`).join("")}
          </div>
          <div class="cart-total-row"><span style="font-weight:800">Итого</span><strong>${money(cartTotal())}</strong></div>
          <button class="btn btn-green btn-block" id="cart-checkout">Оформить заказ</button>
          <p style="font-size:12.5px;color:var(--gray);text-align:center;margin-top:10px">Корзина сохраняется — ваш заказ не потеряется, даже если закроете сайт.</p>
        ` : `
          <div class="cart-empty">
            <p style="font-size:38px;margin-bottom:10px">🧺</p>
            <p style="font-weight:800;font-size:17px;color:var(--ink);margin-bottom:6px">Пока пусто</p>
            <p>Выберите вкусы в каталоге — корзина сохранит ваш выбор.</p>
            <button class="btn btn-green" data-close style="margin-top:18px" onclick="location.hash='#catalog'">Перейти к урбечам</button>
          </div>`}`;
      const co = $("#cart-checkout");
      if (co) co.addEventListener("click", () => openCheckout(null, "cart"));
    }
    document.addEventListener("click", e => {
      const q = e.target.closest("[data-qty]");
      if (!q) return;
      const parts = q.dataset.qty.split("|");
      const delta = +parts.pop();
      const k = parts.join("|");
      setQty(k, (getCart()[k] || 0) + delta);
    });

    /* ═══ ОФОРМЛЕНИЕ ЗАКАЗА ═══ */
    let checkoutItems = null;
    let checkoutMode = "cart";

    function openCheckout(items, mode) {
      checkoutItems = items;
      checkoutMode = mode || "cart";
      const lines = items
        ? items.map(i => { const info = itemInfo(i.key); return { ...info, qty: i.qty, sum: info.price * i.qty }; })
        : cartLines();
      if (!lines.length) { toast("Корзина пуста"); return; }
      const total = lines.reduce((s, l) => s + l.sum, 0);

      $("#checkout-sheet").innerHTML = `
        <div class="sheet-grip"></div>
        <button class="sheet-close" data-close>✕</button>
        <h3 style="font-size:24px;margin-bottom:12px">Оформление заказа</h3>
        <div class="order-summary-mini">
          ${lines.map(l => `<div><span>${l.label} ${l.sub} × ${l.qty}</span><span>${money(l.sum)}</span></div>`).join("")}
          <div><span class="delivery-line">Доставка Ozon</span><span class="delivery-line">рассчитаем по ПВЗ</span></div>
          <div class="osm-total"><span>Итого</span><span>${money(total)} + доставка</span></div>
        </div>
        <form class="form-grid" id="order-form">
          <label>Имя *<input name="name" required placeholder="Как к вам обращаться"></label>
          <label>Телефон *<input name="phone" type="tel" required placeholder="+7 ___ ___-__-__"></label>
          <label>Город *<input name="city" required placeholder="Например: Махачкала"></label>
          <label>ПВЗ Ozon или адрес доставки *<input name="pvz" required placeholder="Адрес пункта выдачи Ozon"></label>
          <button class="btn btn-green btn-block" type="submit">Оплатить заказ</button>
          <p style="font-size:12px;color:var(--gray);text-align:center">Тестовый режим: оплата не списывается. Стоимость доставки подтвердим перед оплатой.</p>
        </form>`;
      openSheet("checkout-sheet");

      $("#order-form").addEventListener("submit", e => {
        e.preventDefault();
        const fd = new FormData(e.target);

        const orders = JSON.parse(localStorage.getItem("urbawild_orders") || "[]");
        orders.unshift({
          id: Date.now(),
          date: new Date().toLocaleString("ru-RU"),
          name: fd.get("name") || "",
          phone: fd.get("phone") || "",
          city: fd.get("city") || "",
          pvz: fd.get("pvz") || "",
          items: lines.map(l => ({ label: l.label + " " + l.sub, qty: l.qty, sum: l.sum })),
          total, status: "new", pay: "тест (СБП подключим)"
        });
        localStorage.setItem("urbawild_orders", JSON.stringify(orders));

        const orderText =
          "Новый заказ URBAWILD:%0A%0A" +
          lines.map(l => "• " + l.label + " " + l.sub + " × " + l.qty + " — " + money(l.sum)).join("%0A") +
          "%0A%0AИтого: " + money(total) +
          "%0AИмя: " + (fd.get("name") || "") +
          "%0AТелефон: " + (fd.get("phone") || "") +
          "%0AГород: " + (fd.get("city") || "") +
          "%0AПВЗ: " + (fd.get("pvz") || "");
        $("#checkout-sheet").innerHTML = `
          <div class="sheet-grip"></div>
          <button class="sheet-close" data-close>✕</button>
          <div class="success-box">
            <div class="check-circle">✓</div>
            <h3>Заказ успешно оформлен</h3>
            <p>Спасибо за заказ. Мы соберём его и передадим в доставку Ozon. Если понадобится уточнение, мы свяжемся с вами по телефону.</p>
            <button class="btn btn-green btn-block" data-close>Вернуться в магазин</button>
            <a class="btn btn-outline btn-block" style="margin-top:10px" target="_blank" rel="noopener"
               href="https://wa.me/${WA_NUMBER}?text=${orderText}">Продублировать заказ в WhatsApp</a>
          </div>`;
        if (checkoutMode === "cart") saveCart({});
      });
    }

    /* ═══ ГЛОБАЛЬНЫЕ КЛИКИ ═══ */
    document.addEventListener("click", e => {
      const add = e.target.closest("[data-add]");
      if (add) { addToCart(add.dataset.add); return; }

      const buy = e.target.closest("[data-buy-now]");
      if (buy) { openCheckout([{ key: buy.dataset.buyNow, qty: 1 }], "buynow"); return; }

      const openP = e.target.closest("[data-open-product]");
      if (openP) { openProduct(openP.dataset.openProduct); return; }

      if (e.target.closest("[data-open-cart]")) { renderCartSheet(); openSheet("cart-sheet"); return; }

      if (e.target.closest("[data-open-menu]")) { openSheet("menu-sheet"); return; }

      if (e.target.closest("[data-open-search]")) {
        openSheet("search-sheet");
        renderSearch("");
        setTimeout(() => $("#search-input").focus(), 250);
        return;
      }

      if (e.target.closest("[data-open-opt]")) { openOpt(); return; }

      if (e.target.closest("[data-close]")) { closeSheets(); return; }
    });

    /* ═══ ОПТ — отдельный экран ═══ */
    function openOpt() {
      closeSheets();
      let optFlavor = null;
      let optSugar = "Без сахара";

      $("#screen-opt").innerHTML = `
        <section class="section opt-page">
          <a class="opt-back" href="#top">← На главную</a>
          <div class="sec-head" style="text-align:left;margin:0 0 10px">
            <span class="eyebrow">Опт от 10 кг</span>
            <h2 class="sec-title" style="font-size:clamp(26px,7vw,40px)">Оптовые поставки</h2>
            <p class="sec-lead">Натуральный дагестанский урбеч собственного производства — для кофеен, магазинов, производств и для себя.</p>
          </div>

          <div class="opt-card">
            <h4 class="opt-step">Шаг 1 · Выберите вкус</h4>
            <div class="opt-flavors" id="opt-flavors">
              ${Object.keys(PRODUCTS).map(id => `
                <button type="button" class="opt-fl" data-optfl="${id}">
                  ${jarHTML(id, { w: 46, h: 62 })}
                  <span>${PRODUCTS[id].name}</span>
                </button>`).join("")}
            </div>
          </div>

          <div class="opt-card">
            <h4 class="opt-step">Шаг 2 · Количество</h4>
            <label class="opt-lab">Сколько килограммов вам нужно?
              <small>Минимум 10 кг, максимум 200 кг. Введите любое число: 10, 25, 47, 120…</small>
              <input id="opt-qty" type="number" inputmode="numeric" min="1" placeholder="Например: 25">
            </label>
            <p class="opt-note" id="opt-over" style="display:none">Для заказа свыше 200 кг свяжитесь с нами — подготовим индивидуальное предложение.</p>
            <p class="opt-note" id="opt-under" style="display:none">Минимальный оптовый объём — 10 кг.</p>
            <div id="opt-sugar-wrap" style="display:none">
              <h4 class="opt-step" style="margin-top:16px">Состав</h4>
              <div class="size-row" style="display:flex;gap:8px" id="opt-sugar-btns">
                <button type="button" class="size-btn active" data-sugar="Без сахара" style="flex:1"><strong>Без сахара</strong></button>
                <button type="button" class="size-btn" data-sugar="С сахаром" style="flex:1"><strong>С сахаром</strong></button>
              </div>
            </div>
          </div>

          <div class="opt-card">
            <h4 class="opt-step">Контактные данные</h4>
            <form class="form-grid" id="opt-form" style="margin-top:0">
              <label>Имя *<input name="name" required placeholder="Как к вам обращаться"></label>
              <label>Телефон *<input name="phone" type="tel" required placeholder="+7 ___ ___-__-__"></label>
              <button class="btn btn-green btn-block" type="submit">Отправить заявку</button>
            </form>
          </div>
        </section>`;
      showScreen("opt");

      $("#opt-flavors").addEventListener("click", e => {
        const b = e.target.closest("[data-optfl]");
        if (!b) return;
        $$("#opt-flavors .opt-fl").forEach(x => x.classList.remove("selected"));
        b.classList.add("selected");
        optFlavor = b.dataset.optfl;
      });

      const qtyInput = $("#opt-qty");
      qtyInput.addEventListener("input", () => {
        const q = parseInt(qtyInput.value) || 0;
        $("#opt-over").style.display = q > 200 ? "block" : "none";
        $("#opt-under").style.display = (q > 0 && q < 10) ? "block" : "none";
        $("#opt-sugar-wrap").style.display = q >= 150 && q <= 200 ? "block" : "none";
      });

      $("#opt-sugar-btns").addEventListener("click", e => {
        const b = e.target.closest("[data-sugar]");
        if (!b) return;
        $$("#opt-sugar-btns .size-btn").forEach(x => x.classList.remove("active"));
        b.classList.add("active");
        optSugar = b.dataset.sugar;
      });

      $("#opt-form").addEventListener("submit", e => {
        e.preventDefault();
        const q = parseInt(qtyInput.value) || 0;
        if (!optFlavor) { toast("Выберите вкус — шаг 1"); return; }
        if (q < 10) { toast("Минимальный объём — 10 кг"); return; }
        if (q > 200) { toast("Свыше 200 кг — свяжитесь с нами"); return; }

        const fd = new FormData(e.target);
        const reqs = JSON.parse(localStorage.getItem("urbawild_opt") || "[]");
        reqs.unshift({
          id: Date.now(),
          date: new Date().toLocaleString("ru-RU"),
          flavor: PRODUCTS[optFlavor].name,
          qty: q,
          sugar: q >= 150 ? optSugar : "—",
          name: fd.get("name") || "",
          phone: fd.get("phone") || "",
          status: "new"
        });
        localStorage.setItem("urbawild_opt", JSON.stringify(reqs));

        const waTxt = "Оптовая заявка URBAWILD:%0AВкус: " + PRODUCTS[optFlavor].name +
          "%0AКоличество: " + q + " кг" +
          (q >= 150 ? "%0AСостав: " + optSugar : "") +
          "%0AИмя: " + (fd.get("name") || "") + "%0AТелефон: " + (fd.get("phone") || "");

        $("#screen-opt").innerHTML = `
          <section class="section opt-page">
            <div class="success-box">
              <div class="check-circle">✓</div>
              <h3>Спасибо!</h3>
              <p>Мы получили вашу заявку.<br>В ближайшее время свяжемся с вами для уточнения деталей.</p>
              <a class="btn btn-green btn-block" href="#top">Вернуться в магазин</a>
              <a class="btn btn-outline btn-block" style="margin-top:10px" target="_blank" rel="noopener"
                 href="https://wa.me/${WA_NUMBER}?text=${waTxt}">Продублировать в WhatsApp</a>
            </div>
          </section>`;
      });
    }

    /* ═══ ПОИСК ═══ */
    function renderSearch(q) {
      const query = q.trim().toLowerCase();
      const found = Object.keys(PRODUCTS).filter(id =>
        !query || PRODUCTS[id].name.toLowerCase().includes(query) || PRODUCTS[id].ing.toLowerCase().includes(query)
      );
      $("#search-results").innerHTML = found.length
        ? found.map(id => `
            <button class="search-row" data-open-product="${id}">
              <span class="dot" style="background:${PRODUCTS[id].color}"></span>
              <span><strong>${PRODUCTS[id].name}</strong><small>от ${money(PRODUCTS[id].prices[250])} · ${PRODUCTS[id].desc}</small></span>
            </button>`).join("")
        : `<p class="search-empty">Ничего не нашлось. Попробуйте: «миндаль», «лён», «фисташка».</p>`;
    }
    document.addEventListener("input", e => {
      if (e.target.id === "search-input") renderSearch(e.target.value);
    });

    /* ═══ ФОРМА ПАРТНЁРА ═══ */
    function openPartnerForm() {
      $("#checkout-sheet").innerHTML = `
        <div class="sheet-grip"></div>
        <button class="sheet-close" data-close>✕</button>
        <h3 style="font-size:24px;margin-bottom:6px">Заявка для бизнеса</h3>
        <p style="color:var(--gray);font-size:14px;margin-bottom:8px">Кофейни, магазины, опт, корпоративные подарки. Ответим в течение дня.</p>
        <form class="form-grid" id="partner-form">
          <label>Имя *<input name="name" required placeholder="Как к вам обращаться"></label>
          <label>Телефон *<input name="phone" type="tel" required placeholder="+7 ___ ___-__-__"></label>
          <label>Компания<input name="company" placeholder="Название кофейни / магазина"></label>
          <label>Комментарий<textarea name="comment" rows="2" placeholder="Что интересует: объёмы, вкусы"></textarea></label>
          <button class="btn btn-green btn-block" type="submit">Отправить заявку</button>
        </form>`;
      openSheet("checkout-sheet");
      $("#partner-form").addEventListener("submit", e => {
        e.preventDefault();
        const fd = new FormData(e.target);
        const txt = "Здравствуйте! Заявка для бизнеса с сайта URBAWILD:%0AИмя: " + (fd.get("name")||"") +
          "%0AТелефон: " + (fd.get("phone")||"") +
          (fd.get("company") ? "%0AКомпания: " + fd.get("company") : "") +
          (fd.get("comment") ? "%0AКомментарий: " + fd.get("comment") : "");
        $("#checkout-sheet").innerHTML = `
          <div class="sheet-grip"></div>
          <button class="sheet-close" data-close>✕</button>
          <div class="success-box">
            <span class="emoji">🤝</span>
            <h3>Спасибо! Заявка принята.</h3>
            <p>Мы скоро свяжемся с вами.</p>
            <a class="btn btn-green btn-block" target="_blank" rel="noopener" href="https://wa.me/${WA_NUMBER}?text=${txt}">Продублировать в WhatsApp</a>
            <button class="btn btn-outline btn-block" data-close style="margin-top:10px">Вернуться на сайт</button>
          </div>`;
      });
    }

    /* ═══ РОУТЕР ЭКРАНОВ ═══ */
    function screenForId(id){ return id === "hits" ? "hits" : id === "catalog" ? "catalog" : id === "sets" ? "sets" : id === "story" ? "story" : "home"; }
    function showScreen(name){
      document.querySelectorAll(".screen").forEach(el => el.classList.toggle("active", el.dataset.screenView === name));
      document.querySelectorAll(".dock a").forEach(a => {
        const id = (a.getAttribute("href") || "").replace("#","");
        a.classList.toggle("dock-active", screenForId(id) === name);
      });
      window.scrollTo(0, 0);
    }
    function route(id){
      if (id === "opt") { openOpt(); return; }
      if (id === "sets") { showScreen("sets"); return; }
      if (id === "story") { showScreen("story"); return; }
      if (id === "hits" || id === "catalog") { showScreen(id); return; }
      showScreen("home");
      if (id && id !== "top") {
        const el = document.getElementById(id);
        if (el) requestAnimationFrame(() => el.scrollIntoView({ behavior: "smooth", block: "start" }));
      }
    }
    function applyHash(){ route((location.hash || "#top").replace("#","")); }
    window.addEventListener("hashchange", applyHash);
    applyHash();

    /* старт */
    refreshCartUI();
  
    /* ═══ SCROLLYTELLING: мягкое появление секций (безопасно) ═══ */
    (function () {
      document.documentElement.classList.add("js");
      const home = document.querySelector('[data-screen-view="home"]');
      if (!home) return;
      const els = home.querySelectorAll(".section, .intro-card, .trust-strip");
      els.forEach(e => e.classList.add("reveal"));
      const reveal = e => e.classList.add("in");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver((ents) => {
          ents.forEach(x => { if (x.isIntersecting) { reveal(x.target); io.unobserve(x.target); } });
        }, { threshold: .08, rootMargin: "0px 0px -6% 0px" });
        els.forEach(e => io.observe(e));
        setTimeout(() => els.forEach(reveal), 1500);
      } else { els.forEach(reveal); }
    })();
</script>
</body>
</html>
